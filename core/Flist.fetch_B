//
// Dev copy of the retired fetch tree (core/smt at 3745cfb06) for R6-R11:
// sbi_console_init, HSM hart start, sbi_hart_switch_mode / cookie cave.
//
// Mutually exclusive with default core/frontend and with Flist.fetch /
// Flist.smt_legacy. To try this tree:
//   1. keep +define+G6LC_FETCH_B
//   2. comment core/instr_realign.sv and
//              core/frontend/{frontend,instr_queue,instr_scan}.sv
//              plus core/smt/g6lc_fetch_{pkg,dbg}.sv
//   3. add -f Flist.fetch_B
//
// Do not compile two frontends. Predictors in this tree duplicate
// core/frontend btb/bht/ras/g6lc_bp_*; this flist uses the copies here.
//
///////////////////////////////////////////////////////////////////////////////

+incdir+${CVA6_REPO_DIR}/core/include/
+incdir+${CVA6_REPO_DIR}/vendor/pulp-platform/common_cells/include/

${CVA6_REPO_DIR}/core/fetch_B/g6lc_fetch_pkg.sv
${CVA6_REPO_DIR}/core/fetch_B/instr_realign.sv
${CVA6_REPO_DIR}/core/fetch_B/instr_scan.sv
${CVA6_REPO_DIR}/core/fetch_B/instr_queue.sv
${CVA6_REPO_DIR}/core/fetch_B/btb.sv
${CVA6_REPO_DIR}/core/fetch_B/bht.sv
${CVA6_REPO_DIR}/core/fetch_B/bht2lvl.sv
${CVA6_REPO_DIR}/core/fetch_B/ras.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_bp_gshare.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_bp_ghist.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_bp_ckpt.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_bp_tage_table.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_bp_tage.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_bp_loop.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_bp_ittage.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_bp_statcor.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_bp_top.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_ftq.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_fdip.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_loop_buffer.sv
${CVA6_REPO_DIR}/core/fetch_B/frontend.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_fetch_dbg.sv
