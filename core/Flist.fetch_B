///////////////////////////////////////////////////////////////////////////////
//
// R6-R11 workspace: instruction supply for sbi_console_init, HSM hart start,
// sbi_hart_switch_mode / cookie cave. Byte copy of retired fetch at
// 3745cfb06; further fetch RTL goes here, not core/frontend or core/smt.
//
// Default Flist.cva6 includes this file (G6LC_FETCH_B). Mutually exclusive
// with frozen A (core/frontend + core/instr_realign + core/smt pkg/dbg)
// and with Flist.smt_legacy. Do not compile two frontends.
//
// Predictors stay in core/frontend and are listed by Flist.cva6, not here.
// The 16 uncompiled predictor copies that used to sit in this directory were
// dropped (they were byte-identical to core/frontend apart from CRLF and
// mojibake, and were a silent "edited the wrong copy" trap). This directory
// now contains exactly the six files listed below: if a file is here, it is
// compiled. Do not re-add a predictor copy; edit core/frontend instead.
//
// To soak frozen A instead, see Flist.fetch. Oracle: drop G6LC_FETCH_B
// and this include, add -f Flist.smt_legacy, leave predictors.
//
///////////////////////////////////////////////////////////////////////////////

+incdir+${CVA6_REPO_DIR}/core/include/
+incdir+${CVA6_REPO_DIR}/vendor/pulp-platform/common_cells/include/

${CVA6_REPO_DIR}/core/fetch_B/g6lc_fetch_pkg.sv
${CVA6_REPO_DIR}/core/fetch_B/instr_realign.sv
${CVA6_REPO_DIR}/core/fetch_B/instr_scan.sv
${CVA6_REPO_DIR}/core/fetch_B/instr_queue.sv
${CVA6_REPO_DIR}/core/fetch_B/frontend.sv
${CVA6_REPO_DIR}/core/fetch_B/g6lc_fetch_dbg.sv
