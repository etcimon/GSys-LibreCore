///////////////////////////////////////////////////////////////////////////////
//
// Opt-in g1* frontend oracle (handoff A), retired from core/frontend.
// Mutually exclusive with default Flist.fetch_B and with frozen A
// (core/frontend + core/smt/g6lc_fetch_{pkg,dbg}).
//
// Rebuild the oracle harness:
//   1. drop +define+G6LC_FETCH_B and -f Flist.fetch_B
//   2. add     -f Flist.smt_legacy
//   3. leave   predictors (btb/bht/ras/g6lc_bp_*) and
//              g6lc_way_predictor / g6lc_rrip_repl in Flist.cva6
//
// Do not compile both frontends. SMT banks and recover packages live here.
//
///////////////////////////////////////////////////////////////////////////////

+incdir+${CVA6_REPO_DIR}/core/include/
+incdir+${CVA6_REPO_DIR}/vendor/pulp-platform/common_cells/include/

${CVA6_REPO_DIR}/core/smt_legacy/instr_realign.sv
${CVA6_REPO_DIR}/core/smt_legacy/instr_scan.sv
${CVA6_REPO_DIR}/core/smt_legacy/instr_queue.sv
${CVA6_REPO_DIR}/core/smt_legacy/frontend.sv
