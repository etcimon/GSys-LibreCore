# U5 ROB occupancy formal — proves against live g6lc_rob (single-port cone).
# Uses yosys-slang so `parameter type entry_t` elaborates (classic front-end cannot).
# Run: sby -f core/ooo/formal/g6lc_ooo_rob.sby
# Wired into build-platform verify.formalTasks (cva6-build verify --formal).

[options]
# BMC from forced reset (initial assume in props). Induction free-state is
# deferred; depth covers fill/drain of ROB_ENTRIES=8 plus flush.
mode bmc
depth 16

[engines]
# abc bmc3: smtbmc z3 made no progress in 1200 s at 32 GB on this four-assert
# model (2026-09-21); bit-level BMC finishes it.
abc bmc3

[script]
# sv-elab/slang is integrated into Yosys from v0.67, so `read_slang` needs no
# plugin. Loading one when the .so is absent is a hard error, and on a recent
# Yosys the plugin would only shadow the built-in frontend -- so do not load it.
# `build-platform tools install formal` provisions a Yosys new enough for this.
# No --keep-hierarchy: slang refuses a hierarchical reference (dut.count_q)
# across a preserved boundary; the flattened design keeps the asserts.
# -DFORMAL is mandatory: the properties live under `ifdef FORMAL`. Without it
# this task elaborated zero assertions and reported PASS (found 2026-09-21).
read_slang --std 1800-2017 --top g6lc_ooo_rob_props -DFORMAL g6lc_rob.sv g6lc_ooo_rob_props.sv
prep -top g6lc_ooo_rob_props

[files]
../g6lc_rob.sv
g6lc_ooo_rob_props.sv
