# R6 instruction-queue formal (bounded) - I6 clause 1: program-order issue.
#
# Checks the live `instr_queue` against an independently watched accepted
# entry and ghost occupancy. Sparse inputs, arbitrary PCs, partial carry,
# exceptions and predicted targets remain live; no DUT timestamp provides
# the expected order, payload or metadata.
#
# Run: sby -f core/fetch_B/formal/g6lc_fetch_iq_order.sby
# Kept separate from the raw-opcode non-interference task. Bounded PASS is
# not an unbounded proof; reachability is reported independently of safety.

[tasks]
bmc
cover
prove

[options]
# One live queue; depth must cover fill, a few dual issues, a replay and a flush.
bmc: mode bmc
cover: mode cover
prove: mode prove
bmc: depth 12
cover: depth 28
prove: depth 4
bmc: aigsmt z3
prove: aigsmt z3

[engines]
# abc-bmc3 first (far faster than z3 on this bit-level cone); both are raced.
bmc: abc bmc3
bmc: smtbmc --unroll z3
cover: smtbmc --unroll z3
prove: abc pdr
prove: smtbmc --unroll z3

[script]
read_slang --std 1800-2017 --top g6lc_fetch_iq_order_props -DFORMAL \
    g6lc64_smt2_config_pkg.sv config_pkg.sv riscv_pkg.sv ariane_pkg.sv \
    g6lc_fetch_pkg.sv cva6_fifo_v3.sv instr_queue.sv g6lc_fetch_iq_order_props.sv
prep -top g6lc_fetch_iq_order_props

[files]
../../include/g6lc64_smt2_config_pkg.sv
../../include/config_pkg.sv
../../include/riscv_pkg.sv
../../include/ariane_pkg.sv
../g6lc_fetch_pkg.sv
../../cva6_fifo_v3.sv
../instr_queue.sv
g6lc_fetch_iq_order_props.sv
