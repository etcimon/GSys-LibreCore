# R6 fetch packet/slot ordering formal (bounded) — pure g6lc_fetch_pkg functions.
# Run: sby -f core/fetch_B/formal/g6lc_fetch_order.sby
# Wired into build-platform verify.formalTasks (cva6-build verify --formal).

[options]
# Combinational contract over one packet.
mode prove
depth 4

[engines]
smtbmc z3

[script]
read -formal config_pkg.sv g6lc_fetch_pkg.sv g6lc_fetch_order_props.sv
prep -top g6lc_fetch_order_props

[files]
../../include/config_pkg.sv
../g6lc_fetch_pkg.sv
g6lc_fetch_order_props.sv
