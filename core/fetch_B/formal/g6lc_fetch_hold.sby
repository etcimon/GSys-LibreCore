# R6 redirect-hold formal (bounded) - the SAFETY half of I9/I23.
#
# Proves against the LIVE frontend (predictors + realigner + queue all
# elaborate). What is proven: a hold is never released silently -- only by the
# target arriving, a flush, or a superseding architectural redirect -- and while
# holding, the address presented to the I$ stays the held target.
#
# What is NOT proven here, on purpose: the I23 BOUND. A hold ends when the I$
# eventually returns, so boundedness is conditional on environment fairness; it
# stays an L3 observation in g6lc_fetch_dbg. See the header of the props file and
# core-fetch/SPEC.md s10.
#
# Run: sby -f core/fetch_B/formal/g6lc_fetch_hold.sby
# Wired into build-platform verify.formalTasks (cva6-build verify --formal).

[options]
# Whole frontend: the cone is much larger than the per-module proofs, so BMC
# rather than unbounded induction, at a depth that covers request -> kill ->
# re-present -> hit.
mode bmc
depth 8

[engines]
abc bmc3
smtbmc z3

[script]
# read_slang: frontend takes four `parameter type` structs and the classic
# frontend cannot elaborate those, nor resolve the hierarchical reads of
# dut.redirect_* that these properties need.
read_slang --std 1800-2017 --allow-use-before-declare --top g6lc_fetch_hold_props -DFORMAL \
    g6lc64_smt2_config_pkg.sv config_pkg.sv riscv_pkg.sv ariane_pkg.sv g6lc_fetch_pkg.sv cva6_fifo_v3.sv instr_realign.sv instr_scan.sv instr_queue.sv bht.sv bht2lvl.sv btb.sv ras.sv g6lc_bp_ckpt.sv g6lc_bp_ghist.sv g6lc_bp_gshare.sv g6lc_bp_ittage.sv g6lc_bp_loop.sv g6lc_bp_statcor.sv g6lc_bp_tage_table.sv g6lc_bp_tage.sv g6lc_bp_top.sv g6lc_fdip.sv g6lc_ftq.sv g6lc_loop_buffer.sv frontend.sv g6lc_fetch_hold_props.sv
prep -top g6lc_fetch_hold_props

