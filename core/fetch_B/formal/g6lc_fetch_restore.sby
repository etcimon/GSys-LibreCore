# Hart-blind frontend state vs SMT restore (bounded) against the LIVE frontend.
#
# Target shape: g6lc64_smt2_ooo_int uplift — NrHarts=2, FtqDepth=8,
# LoopBufEn=1 (LoopBufEntries=8). A restore accepted (arch_src == SRC_RESTORE)
# must leave no pre-restore entry in the FTQ next cycle and must leave the
# loop buffer unarmed. -DFORMAL is mandatory (assert count must be nonzero).
#
# Run: sby -f core/fetch_B/formal/g6lc_fetch_restore.sby

[options]
mode bmc
depth 16

[engines]
smtbmc yices

[script]
read_slang --std 1800-2017 --allow-use-before-declare --top g6lc_fetch_restore_props -DFORMAL \
    g6lc64_smt2_config_pkg.sv config_pkg.sv riscv_pkg.sv ariane_pkg.sv g6lc_fetch_pkg.sv cva6_fifo_v3.sv instr_realign.sv instr_scan.sv instr_queue.sv bht.sv bht2lvl.sv btb.sv ras.sv g6lc_bp_ckpt.sv g6lc_bp_ghist.sv g6lc_bp_gshare.sv g6lc_bp_ittage.sv g6lc_bp_loop.sv g6lc_bp_statcor.sv g6lc_bp_tage_table.sv g6lc_bp_tage.sv g6lc_bp_top.sv g6lc_fdip.sv g6lc_ftq.sv g6lc_loop_buffer.sv frontend.sv g6lc_fetch_restore_props.sv
prep -top g6lc_fetch_restore_props

