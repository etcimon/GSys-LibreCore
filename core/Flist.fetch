///////////////////////////////////////////////////////////////////////////////
//
// Frozen-A fetch package: pkg + dbg only (core/smt/). Supply copies that
// used to live here were applied to core/frontend + core/instr_realign and
// removed so they cannot dual-compile.
//
// Default Flist.cva6 compiles the R6-R11 workspace (Flist.fetch_B), not
// this file. To soak frozen A instead:
//   1. keep +define+G6LC_FETCH_B
//   2. drop -f Flist.fetch_B
//   3. restore core/smt/g6lc_fetch_{pkg,dbg}.sv,
//              core/instr_realign.sv, and
//              core/frontend/{frontend,instr_queue,instr_scan}.sv
//   4. leave predictors in core/frontend
//
// Mutually exclusive with Flist.fetch_B and Flist.smt_legacy.
// Do not compile two frontends.
//
///////////////////////////////////////////////////////////////////////////////

+incdir+${CVA6_REPO_DIR}/core/include/
+incdir+${CVA6_REPO_DIR}/vendor/pulp-platform/common_cells/include/

${CVA6_REPO_DIR}/core/smt/g6lc_fetch_pkg.sv
${CVA6_REPO_DIR}/core/smt/g6lc_fetch_dbg.sv
