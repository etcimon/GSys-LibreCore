diff --git a/core/include/build_config_pkg.sv b/core/include/build_config_pkg.sv
index 21ad86fb6..130e0096d 100644
--- a/core/include/build_config_pkg.sv
+++ b/core/include/build_config_pkg.sv
@@ -100,6 +100,7 @@ package build_config_pkg;
     // cont.14 shows it is necessary for stock /cpus with current STQ RTL.
     cfg.SpeculativeSb = CVA6Cfg.SliceOoOEn || CVA6Cfg.OoOEn || CVA6Cfg.DeepSpecEn;
     cfg.DeepSpecEn = CVA6Cfg.DeepSpecEn;
+    cfg.StqInputStage = CVA6Cfg.StqInputStage;
 
     // Dual ALU minimum under SS; scale toward issue width (cap 4 for area).
     // Hang-6: NrALUs=1 under dual still BADOFFSET — not dual-ALU residual.
diff --git a/core/include/config_pkg.sv b/core/include/config_pkg.sv
index a8068c0d1..1e54ad4ab 100644
--- a/core/include/config_pkg.sv
+++ b/core/include/config_pkg.sv
@@ -711,6 +711,9 @@ package config_pkg;
     // FSE: deep speculation depth plane (architecture/speculative-execution/)
     // 0 = legacy STQ depth 4 + package-stated buffers; 1 = auto floors + deeper STQ
     bit          DeepSpecEn;
+    // A138: store buffer input stage (request/commit/flush/cancel captured
+    // before the speculative-queue permutation; +1 cycle store handoff)
+    bit          StqInputStage;
     int unsigned RobEntries;          // ROB depth (0 → NrScoreboardEntries when OoOEn)
     int unsigned PrfEntries;          // physical RF size (0 → 32+RobEntries)
     int unsigned IqEntries;           // unified IQ depth (0 → RobEntries)
@@ -789,6 +792,7 @@ package config_pkg;
     int unsigned NrIssuePorts;
     bit          SpeculativeSb;
     bit          DeepSpecEn;          // FSE depth plane (STQ/load/ckpt floors)
+    bit          StqInputStage;       // A138 store-buffer input stage
 
     int unsigned NrALUs;
     bit          ALUBypass;
@@ -1291,6 +1295,10 @@ package config_pkg;
     assert (!(Cfg.DeepSpecEn && Cfg.BPCkptDepth != 0 &&
               Cfg.BPCkptDepth < Cfg.NR_SB_ENTRIES));
     assert (!(Cfg.DeepSpecEn && Cfg.MaxOutstandingStores > 16)); // STQ CAM cap v1
+    // A138: the staged store buffer excludes the legacy SMT keep path (its
+    // permutation reads the live load address) and needs the speculative queue.
+    assert (!(Cfg.StqInputStage && Cfg.SuperscalarEn && Cfg.NrHarts > 1 && !Cfg.OoOEn));
+    assert (!(Cfg.StqInputStage && !Cfg.SpeculativeSb));
     // L3 sits below L2; line size must match for inclusive hierarchy.
     assert (!(Cfg.L3En && !Cfg.L2En));
     assert (!(Cfg.L3En && Cfg.L3ByteSize == 0));
