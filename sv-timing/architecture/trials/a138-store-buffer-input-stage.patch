+// Copyright 2026 Etienne Cimon
+// SPDX-License-Identifier: MIT
+//
+// Witness for the A138 store-buffer input stage (CVA6Cfg.StqInputStage).
+//
+// Three instances share one random legal stimulus (g6lc64_ooo geometry):
+//   u_new  live RTL, StqInputStage = 1 (the design under test; the flist's
+//          cva6_config_pkg must be the g6lc64_ooo package)
+//   u_del  reference RTL (a prior revision renamed store_buffer_old) whose
+//          STAGED inputs (store request, commit, flush, cancel mask, age
+//          anchor) arrive one cycle late and whose other inputs are live
+//   u_ref  reference RTL with every input live (the previous semantics)
+// Checks, every cycle after reset:
+//   SHIFT   u_new's queue / pointer / count / commit-queue state == u_del's
+//           (the stage is exactly a one-cycle delay of the permutation's
+//           inputs), req_port_o and no_st_pending_o identical
+//   STALL   u_ref.page_offset_matches_o -> u_new.page_offset_matches_o
+//   FWD     every byte u_ref forwards is forwarded by u_new with the same
+//           value, or u_new stalls the load (page_offset_matches_o); a byte
+//           u_new forwards that u_ref does not is only allowed from the
+//           committing head or in the cycle after a cancel / flush
+//   READY   u_new.ready_o -> u_ref.ready_o-derived capacity holds for the
+//           next push (checked by the reference's own interface assertions)
+//   RVFI    on commit_i, u_new.rvfi_mem_paddr_o names the entry it pops next
+//   EMPTY   u_new.store_buffer_empty_o -> u_ref.store_buffer_empty_o
+module tb_sb_stage;
+  import ariane_pkg::*;
+  function automatic config_pkg::cva6_user_cfg_t staged_user_cfg();
+    staged_user_cfg = cva6_config_pkg::cva6_cfg;
+    staged_user_cfg.StqInputStage = 1'b1;
+  endfunction
+  localparam config_pkg::cva6_cfg_t CfgRef = build_config_pkg::build_config(cva6_config_pkg::cva6_cfg);
+  localparam config_pkg::cva6_cfg_t CfgNew = build_config_pkg::build_config(staged_user_cfg());
+  localparam int DepthSpec = g6lc_ooo_pkg::ooo_spec_store_depth(CfgRef);
+  localparam int TidW = CfgRef.TRANS_ID_BITS;
+  localparam int BE = CfgRef.XLEN / 8;
+  localparam type cbo_t = logic [7:0];
+  typedef struct packed {
+    logic [CfgRef.DCACHE_INDEX_WIDTH-1:0] address_index;
+    logic [CfgRef.DCACHE_TAG_WIDTH-1:0]   address_tag;
+    logic [CfgRef.XLEN-1:0]               data_wdata;
+    logic [CfgRef.DCACHE_USER_WIDTH-1:0]  data_wuser;
+    logic                                 data_req;
+    logic                                 data_we;
+    logic [BE-1:0]                        data_be;
+    logic [1:0]                           data_size;
+    logic [CfgRef.DcacheIdWidth-1:0]      data_id;
+    logic                                 kill_req;
+    logic                                 tag_valid;
+    cbo_t                                 cbo_op;
+  } dcache_req_i_t;
+  typedef struct packed {
+    logic                                 data_gnt;
+    logic                                 data_rvalid;
+    logic [CfgRef.DcacheIdWidth-1:0]      data_rid;
+    logic [CfgRef.XLEN-1:0]               data_rdata;
+    logic [CfgRef.DCACHE_USER_WIDTH-1:0]  data_ruser;
+  } dcache_req_o_t;
+  localparam int HW = $clog2(CfgRef.NrHarts > 1 ? CfgRef.NrHarts : 2);
+
+  logic clk = 1'b0, rst_ni = 1'b0;
+  always #1 clk = ~clk;
+
+  // live stimulus
+  logic flush_i, commit_i, valid_i, valid_without_flush_i, stall_st_pending_i;
+  logic [CfgRef.NR_SB_ENTRIES-1:0] cancelled_mask_i, sb_live_i;
+  logic [11:0] page_offset_i;
+  logic [CfgRef.PLEN-1:0] load_paddr_i, paddr_i;
+  logic load_paddr_valid_i, head_phys_pending_i, dcache_wbuffer_empty_i;
+  logic [TidW-1:0] load_trans_id_i, commit_trans_id_i, oldest_live_tid_i, trans_id_i;
+  logic [HW-1:0] load_hart_i, st_hart_i;
+  logic [CfgRef.XLEN-1:0] data_i;
+  logic [BE-1:0] be_i;
+  logic [1:0] data_size_i;
+  cbo_t cbo_op_i;
+  // Memory handshakes are protocol-legal per instance: a CBO response
+  // (rvalid) only follows a grant of that instance's own CBO request, never
+  // in the grant cycle (the previous semantics and the staged design run the
+  // commit queue at different phases, so they cannot share one random
+  // stream). u_new and u_del share a port: their commit queues are identical.
+  dcache_req_o_t req_port_i, req_port_ref_i;
+  logic pend_new, pend_ref;
+  // one-cycle delayed copies of the staged set (for u_del)
+  logic d_flush, d_commit, d_valid;
+  logic [CfgRef.NR_SB_ENTRIES-1:0] d_cancel;
+  logic [CfgRef.PLEN-1:0] d_paddr;
+  logic [TidW-1:0] d_tid, d_anchor, d_ctid;
+  logic [HW-1:0] d_hart;
+  logic [CfgRef.XLEN-1:0] d_data;
+  logic [BE-1:0] d_be;
+  logic [1:0] d_size;
+  cbo_t d_cbo;
+  always_ff @(posedge clk or negedge rst_ni) begin
+    if (!rst_ni) begin
+      d_flush <= 0; d_commit <= 0; d_valid <= 0; d_cancel <= '0; d_paddr <= '0; d_tid <= '0;
+      d_anchor <= '0; d_hart <= '0; d_data <= '0; d_be <= '0; d_size <= '0; d_cbo <= '0; d_ctid <= '0;
+    end else begin
+      d_flush <= flush_i; d_commit <= commit_i; d_valid <= valid_i; d_cancel <= cancelled_mask_i;
+      d_paddr <= paddr_i; d_tid <= trans_id_i; d_anchor <= oldest_live_tid_i; d_hart <= st_hart_i;
+      d_data <= data_i; d_be <= be_i; d_size <= data_size_i; d_cbo <= cbo_op_i; d_ctid <= commit_trans_id_i;
+    end
+  end
+
+  // outputs
+  logic no_st_new, no_st_del, no_st_ref, empty_new, empty_ref, pom_new, pom_ref, pso_new, pso_ref;
+  logic fwdv_new, fwdv_ref, cready_new, cready_ref, cready_del, ready_new, ready_ref;
+  logic [CfgRef.XLEN-1:0] fwdd_new, fwdd_ref;
+  logic [BE-1:0] fwdbe_new, fwdbe_ref;
+  logic [CfgRef.PLEN-1:0] rvfi_new, rvfi_ref;
+  dcache_req_i_t req_new, req_del, req_ref;
+
+  sb_wrap_stage #(.CVA6Cfg(CfgNew)) u_new (
+    .clk_i(clk), .rst_ni, .flush_i, .cancelled_mask_i, .sb_live_i, .stall_st_pending_i,
+    .page_offset_i, .load_paddr_i, .load_paddr_valid_i, .load_trans_id_i, .commit_trans_id_i,
+    .oldest_live_tid_i, .head_phys_pending_i, .load_hart_i, .dcache_wbuffer_empty_i,
+    .commit_i, .valid_i, .valid_without_flush_i, .paddr_i, .trans_id_i, .st_hart_i,
+    .data_i, .be_i, .data_size_i, .cbo_op_i, .req_port_i,
+    .no_st_pending_o(no_st_new), .store_buffer_empty_o(empty_new), .page_offset_matches_o(pom_new),
+    .page_offset_spec_only_o(pso_new), .st_fwd_valid_o(fwdv_new), .st_fwd_data_o(fwdd_new),
+    .st_fwd_be_o(fwdbe_new), .commit_ready_o(cready_new), .ready_o(ready_new),
+    .rvfi_mem_paddr_o(rvfi_new), .req_port_o(req_new));
+  sb_wrap_old #(.CVA6Cfg(CfgRef)) u_del (
+    .clk_i(clk), .rst_ni, .flush_i(d_flush), .cancelled_mask_i(d_cancel), .sb_live_i('1), .stall_st_pending_i,
+    .page_offset_i, .load_paddr_i, .load_paddr_valid_i, .load_trans_id_i, .commit_trans_id_i(d_ctid),
+    .oldest_live_tid_i(d_anchor), .head_phys_pending_i, .load_hart_i, .dcache_wbuffer_empty_i,
+    .commit_i(d_commit), .valid_i(d_valid), .valid_without_flush_i(d_valid && !d_flush),
+    .paddr_i(d_paddr), .trans_id_i(d_tid), .st_hart_i(d_hart),
+    .data_i(d_data), .be_i(d_be), .data_size_i(d_size), .cbo_op_i(d_cbo), .req_port_i,
+    .no_st_pending_o(no_st_del), .store_buffer_empty_o(), .page_offset_matches_o(),
+    .page_offset_spec_only_o(), .st_fwd_valid_o(), .st_fwd_data_o(),
+    .st_fwd_be_o(), .commit_ready_o(cready_del), .ready_o(),
+    .rvfi_mem_paddr_o(), .req_port_o(req_del));
+  sb_wrap_old #(.CVA6Cfg(CfgRef)) u_ref (
+    .clk_i(clk), .rst_ni, .flush_i, .cancelled_mask_i, .sb_live_i, .stall_st_pending_i,
+    .page_offset_i, .load_paddr_i, .load_paddr_valid_i, .load_trans_id_i, .commit_trans_id_i,
+    .oldest_live_tid_i, .head_phys_pending_i, .load_hart_i, .dcache_wbuffer_empty_i,
+    .commit_i, .valid_i, .valid_without_flush_i, .paddr_i, .trans_id_i, .st_hart_i,
+    .data_i, .be_i, .data_size_i, .cbo_op_i, .req_port_i(req_port_ref_i),
+    .no_st_pending_o(no_st_ref), .store_buffer_empty_o(empty_ref), .page_offset_matches_o(pom_ref),
+    .page_offset_spec_only_o(pso_ref), .st_fwd_valid_o(fwdv_ref), .st_fwd_data_o(fwdd_ref),
+    .st_fwd_be_o(fwdbe_ref), .commit_ready_o(cready_ref), .ready_o(ready_ref),
+    .rvfi_mem_paddr_o(rvfi_ref), .req_port_o(req_ref));
+
+  function automatic logic [255:0] rnd256();
+    rnd256 = {$urandom, $urandom, $urandom, $urandom, $urandom, $urandom, $urandom, $urandom};
+  endfunction
+
+  int unsigned cyc = 0, errors = 0, pushes = 0, commits = 0, cancels = 0, flushes = 0, seed = 1;
+  // +cbo: CBO stores with per-instance protocol-legal responses. The previous
+  // semantics then drain on a different stream, so only the staged design's
+  // own relations (SHIFT, RVFI, staged-item accounting, forwarded data
+  // equality) are checked; the cross-instance STALL / FWD-coverage
+  // implications need the shared gnt-only stream of the default mode.
+  bit cbo_mode;
+  int unsigned fwd_ref_bytes = 0, fwd_stall_instead = 0, fwd_extra_bytes = 0, max_occ = 0, stage_commits = 0;
+  int unsigned pc_mode;
+  logic ready_new_q;
+  logic [CfgRef.NR_SB_ENTRIES-1:0] live_tid = '0;
+  // program order: the oldest live slot advances with commits; store tids are
+  // allocated above it so ooo_older is meaningful (a small ring of 32)
+  logic [TidW-1:0] anchor = '0;
+  initial begin
+    if (!$value$plusargs("seed=%d", seed)) seed = 1;
+    cbo_mode = $test$plusargs("cbo");
+    void'($urandom(seed));
+    #7 rst_ni = 1'b1;
+  end
+  always @(negedge clk) begin
+    logic [255:0] r;
+    sb_live_i = '1;
+    r = rnd256(); stall_st_pending_i = r[0];
+    r = rnd256(); page_offset_i = r[11:0];
+    r = rnd256(); load_paddr_i = {r[CfgRef.PLEN-1:12], page_offset_i};
+    // keep loads inside a small address set so forwards and stalls happen
+    load_paddr_i[CfgRef.PLEN-1:6] = {{(CfgRef.PLEN-9){1'b0}}, r[14:12]};
+    page_offset_i = load_paddr_i[11:0];
+    r = rnd256(); load_paddr_valid_i = r[1:0] != 0;
+    r = rnd256(); load_trans_id_i = TidW'(anchor + TidW'(r[4:0] % 24));
+    r = rnd256(); head_phys_pending_i = r[7:0] < 8'd8;
+    r = rnd256(); load_hart_i = '0;
+    r = rnd256(); dcache_wbuffer_empty_i = r[0];
+    r = rnd256(); paddr_i = {r[CfgRef.PLEN-1:0]};
+    paddr_i[CfgRef.PLEN-1:6] = {{(CfgRef.PLEN-9){1'b0}}, r[70:68]};
+    r = rnd256(); st_hart_i = '0;
+    r = rnd256(); data_i = r[CfgRef.XLEN-1:0];
+    r = rnd256(); be_i = r[BE-1:0];
+    r = rnd256(); data_size_i = r[1:0];
+    r = rnd256(); req_port_i = $bits(req_port_i)'(r);
+    req_port_i.data_rvalid = cbo_mode && pend_new && r[200];
+    req_port_ref_i = req_port_i;
+    if (cbo_mode) begin
+      req_port_ref_i.data_gnt = r[201];
+      req_port_ref_i.data_rvalid = pend_ref && r[202];
+    end
+    cbo_op_i = cbo_t'(ariane_pkg::CBO_NONE);
+    if (cbo_mode) case (r[47:40] % 6)
+      1: if (CfgRef.RVZiCbom) cbo_op_i = cbo_t'(ariane_pkg::CBO_CLEAN);
+      2: if (CfgRef.RVZiCboz) begin
+        cbo_op_i = cbo_t'(ariane_pkg::CBO_ZERO);
+        paddr_i[$clog2(CfgRef.DCACHE_LINE_WIDTH >= 64 ? CfgRef.DCACHE_LINE_WIDTH / 8 : 64)-1:0] = '0;
+        data_i = '0; be_i = '1; data_size_i = 2'b11;
+      end
+      default: ;
+    endcase
+    r = rnd256();
+    pc_mode = cyc[11:9];
+    // cancels name live younger tids only (as the scoreboard does)
+    cancelled_mask_i = '0;
+    if ((r[7:0] < 8'd40) || (pc_mode == 3 && r[15:8] < 8'd120)) begin
+      logic [TidW-1:0] cut;
+      cut = TidW'(anchor + TidW'(r[20:16] % 24));
+      for (int t = 0; t < CfgRef.NR_SB_ENTRIES; t++)
+        if (live_tid[t] && g6lc_ooo_pkg::ooo_age_older(TidW, 32'(cut), t, 32'(anchor))) cancelled_mask_i[t] = 1'b1;
+    end
+    flush_i = (r[23:16] < 8'd6);
+    // commit: the previous semantics' head, with room, never with flush; also
+    // only when the staged design can take it
+    commit_i = (r[31:24] < 8'd110) && !flush_i && cready_new &&
+               (u_ref.u.commit_status_cnt_q < u_ref.u.DEPTH_COMMIT) &&
+               (u_ref.u.speculative_status_cnt_q != '0) &&
+               u_ref.u.speculative_queue_q[u_ref.u.speculative_read_pointer_q].valid;
+    commit_trans_id_i = u_ref.u.speculative_queue_q[u_ref.u.speculative_read_pointer_q].trans_id;
+    oldest_live_tid_i = anchor;
+    #0.1;
+    // push only when the staged design said ready last cycle (the store unit
+    // posts one cycle after it saw ready) and the reference has room
+    begin
+      logic can_push;
+      can_push = ready_new_q && (int'(u_ref.u.speculative_status_cnt_q) < DepthSpec);
+      valid_i = ((r[39:32] < 8'd150) || (pc_mode == 5 && r[39:32] < 8'd250)) && can_push && !flush_i;
+    end
+    begin
+      logic [TidW-1:0] cand;
+      cand = TidW'(anchor + TidW'(8 + (r[55:48] % 16)));
+      for (int tries = 0; tries < 24 && live_tid[cand]; tries++) cand = TidW'(anchor + TidW'(8 + ($urandom % 16)));
+      trans_id_i = cand;
+      if (live_tid[cand]) valid_i = 1'b0;
+    end
+    valid_without_flush_i = valid_i;
+  end
+  always @(posedge clk) begin
+    if (!rst_ni) begin pend_new <= 1'b0; pend_ref <= 1'b0; end
+    else begin
+      if (req_port_i.data_rvalid) pend_new <= 1'b0;
+      else if (req_new.data_req && req_port_i.data_gnt && req_new.cbo_op != cbo_t'(ariane_pkg::CBO_NONE)) pend_new <= 1'b1;
+      if (req_port_ref_i.data_rvalid) pend_ref <= 1'b0;
+      else if (req_ref.data_req && req_port_ref_i.data_gnt && req_ref.cbo_op != cbo_t'(ariane_pkg::CBO_NONE)) pend_ref <= 1'b1;
+    end
+  end
+  always @(posedge clk) begin
+    if (!rst_ni) begin live_tid <= '0; ready_new_q <= 1'b0; anchor <= '0; end
+    else begin
+      logic [CfgRef.NR_SB_ENTRIES-1:0] nxt;
+      nxt = live_tid;
+      if (commit_i) nxt[u_ref.u.speculative_queue_q[u_ref.u.speculative_read_pointer_q].trans_id] = 1'b0;
+      nxt &= ~cancelled_mask_i;
+      if (flush_i) nxt = '0;
+      if (valid_i && !cancelled_mask_i[trans_id_i] && !flush_i) nxt[trans_id_i] = 1'b1;
+      live_tid <= nxt;
+      ready_new_q <= ready_new;
+      // the oldest live slot advances slowly; everything live stays above it
+      if (($urandom % 8) == 0 && nxt == '0) anchor <= anchor + TidW'(1);
+    end
+  end
+
+  // RVFI: the address presented on a commit names the entry popped next cycle
+  logic commit_q; logic [CfgRef.PLEN-1:0] rvfi_q;
+  logic [CfgRef.NR_SB_ENTRIES-1:0] cancel_q; logic flush_q;
+  always @(posedge clk) begin
+    commit_q <= commit_i && rst_ni; rvfi_q <= rvfi_new; cancel_q <= cancelled_mask_i; flush_q <= flush_i;
+  end
+  `define CHK(cond, msg) if (!(cond)) begin errors++; if (errors <= 12) $display("[%0d] %s", cyc, msg); end
+  function automatic string qdump(input string tag);
+    qdump = $sformatf("%s: ref rp=%0d cnt=%0d |", tag, u_ref.u.speculative_read_pointer_q, u_ref.u.speculative_status_cnt_q);
+    for (int i = 0; i < DepthSpec; i++)
+      if (u_ref.u.speculative_queue_q[i].valid)
+        qdump = {qdump, $sformatf(" [%0d] t%0d a%h be%h d%h", i, u_ref.u.speculative_queue_q[i].trans_id,
+                 u_ref.u.speculative_queue_q[i].address, u_ref.u.speculative_queue_q[i].be, u_ref.u.speculative_queue_q[i].data)};
+    qdump = {qdump, $sformatf(" || new rp=%0d cnt=%0d cstg=%b in=%b t%0d a%h be%h d%h |", u_new.u.speculative_read_pointer_q,
+             u_new.u.speculative_status_cnt_q, u_new.u.commit_stage_q, u_new.u.in_valid_q, u_new.u.in_q.trans_id,
+             u_new.u.in_q.address, u_new.u.in_q.be, u_new.u.in_q.data)};
+    for (int i = 0; i < DepthSpec; i++)
+      if (u_new.u.speculative_queue_q[i].valid)
+        qdump = {qdump, $sformatf(" [%0d] t%0d a%h be%h d%h", i, u_new.u.speculative_queue_q[i].trans_id,
+                 u_new.u.speculative_queue_q[i].address, u_new.u.speculative_queue_q[i].be, u_new.u.speculative_queue_q[i].data)};
+    qdump = {qdump, $sformatf(" || cq ref=%0d new=%0d anchor=%0d arrival v=%b t%0d a%h be%h", u_ref.u.commit_status_cnt_q,
+             u_new.u.commit_status_cnt_q, oldest_live_tid_i, valid_without_flush_i, trans_id_i, paddr_i, be_i)};
+  endfunction
+  // bytes a commit-queue entry of the staged design covers for this load
+  // (the previous semantics may already have drained that entry to memory)
+  logic [BE-1:0] new_cq_cover;
+  always_comb begin
+    new_cq_cover = '0;
+    for (int i = 0; i < u_new.u.DEPTH_COMMIT; i++)
+      if (u_new.u.commit_queue_q[i].valid) begin
+        if (u_new.u.commit_queue_q[i].address[CfgRef.PLEN-1:3] == load_paddr_i[CfgRef.PLEN-1:3])
+          new_cq_cover |= u_new.u.commit_queue_q[i].be;
+        // a cbo.zero entry zeroes its whole line
+        if (CfgRef.RVZiCboz && u_new.u.commit_queue_q[i].cbo_op == cbo_t'(ariane_pkg::CBO_ZERO) &&
+            u_new.u.commit_queue_q[i].address[CfgRef.PLEN-1:u_new.u.CBOZ_OFF_W] == load_paddr_i[CfgRef.PLEN-1:u_new.u.CBOZ_OFF_W])
+          new_cq_cover = '1;
+      end
+  end
+  // drain / receive bookkeeping for the commit-queue occupancy relation
+  int unsigned ref_drains = 0, new_drains = 0, ref_recv = 0, new_recv = 0;
+  logic [$clog2(u_new.u.DEPTH_COMMIT)-1:0] ref_rp_q, new_rp_q;
+  string hist[4];
+  always @(posedge clk) if (rst_ni) begin
+    cyc++;
+    #0.2;
+    if (u_ref.u.commit_read_pointer_q != ref_rp_q) ref_drains++;
+    if (u_new.u.commit_read_pointer_q != new_rp_q) new_drains++;
+    ref_rp_q = u_ref.u.commit_read_pointer_q; new_rp_q = u_new.u.commit_read_pointer_q;
+    if (commit_i) ref_recv++;
+    if (u_new.u.commit_stage_q) new_recv++;
+    hist[cyc % 4] = $sformatf("[%0d] cm=%b cstg=%b gnt=%b rv=%b st=%b | ref cq=%0d rp=%0d head v=%b wr=%b cbo=%0d tid=%0d | new cq=%0d rp=%0d head v=%b wr=%b cbo=%0d tid=%0d | drains ref=%0d new=%0d recv ref=%0d new=%0d",
+      cyc, commit_i, u_new.u.commit_stage_q, req_port_i.data_gnt, req_port_i.data_rvalid, stall_st_pending_i,
+      u_ref.u.commit_status_cnt_q, u_ref.u.commit_read_pointer_q, u_ref.u.commit_queue_q[u_ref.u.commit_read_pointer_q].valid,
+      u_ref.u.commit_queue_q[u_ref.u.commit_read_pointer_q].wait_rvalid, u_ref.u.commit_queue_q[u_ref.u.commit_read_pointer_q].cbo_op,
+      u_ref.u.commit_queue_q[u_ref.u.commit_read_pointer_q].trans_id,
+      u_new.u.commit_status_cnt_q, u_new.u.commit_read_pointer_q, u_new.u.commit_queue_q[u_new.u.commit_read_pointer_q].valid,
+      u_new.u.commit_queue_q[u_new.u.commit_read_pointer_q].wait_rvalid, u_new.u.commit_queue_q[u_new.u.commit_read_pointer_q].cbo_op,
+      u_new.u.commit_queue_q[u_new.u.commit_read_pointer_q].trans_id, ref_drains, new_drains, ref_recv, new_recv);
+    // (the commit queues of u_ref and u_new drain on different handshake
+    // streams, so no occupancy relation between them is checked here; the
+    // CREADY implication below is checked against u_del instead)
+    // SHIFT: state identity between the staged design and the delayed reference
+    for (int i = 0; i < DepthSpec; i++) begin
+      `CHK(u_new.u.speculative_queue_q[i] == u_del.u.speculative_queue_q[i], $sformatf("SHIFT spec entry %0d differs", i))
+    end
+    `CHK(u_new.u.speculative_read_pointer_q == u_del.u.speculative_read_pointer_q, $sformatf("SHIFT read ptr %0d/%0d", u_new.u.speculative_read_pointer_q, u_del.u.speculative_read_pointer_q))
+    `CHK(u_new.u.speculative_write_pointer_q == u_del.u.speculative_write_pointer_q, $sformatf("SHIFT write ptr %0d/%0d", u_new.u.speculative_write_pointer_q, u_del.u.speculative_write_pointer_q))
+    `CHK(u_new.u.speculative_status_cnt_q == u_del.u.speculative_status_cnt_q, $sformatf("SHIFT cnt %0d/%0d", u_new.u.speculative_status_cnt_q, u_del.u.speculative_status_cnt_q))
+    for (int i = 0; i < u_new.u.DEPTH_COMMIT; i++) begin
+      `CHK(u_new.u.commit_queue_q[i] == u_del.u.commit_queue_q[i], $sformatf("SHIFT commit entry %0d differs", i))
+    end
+    `CHK(u_new.u.commit_read_pointer_q == u_del.u.commit_read_pointer_q && u_new.u.commit_write_pointer_q == u_del.u.commit_write_pointer_q &&
+         u_new.u.commit_status_cnt_q == u_del.u.commit_status_cnt_q && u_new.u.cboz_beat_q == u_del.u.cboz_beat_q, "SHIFT commit pointers/count differ")
+    `CHK(req_new == req_del, $sformatf("SHIFT req_port_o new=%h del=%h", req_new, req_del))
+    // STALL: the staged design stalls every load the previous semantics stalled
+    // The live match (a store present in a queue) must be covered; the R3a
+    // sticky terms follow each instance's own drain events and are not
+    // comparable across the two timings.
+    if (!cbo_mode) begin
+      `CHK(!(u_ref.u.page_offset_matches_now && load_paddr_valid_i) || pom_new, $sformatf("STALL ref=1 new=0 pa=%h ldtid=%0d", load_paddr_i, load_trans_id_i))
+    end
+    // FWD: every byte the previous semantics forwards is forwarded with the
+    // same value or the load is stalled; extra bytes only from the committing
+    // head or in the cycle after a cancel / flush
+    for (int b = 0; b < BE; b++) begin
+      if (fwdbe_ref[b]) begin
+        fwd_ref_bytes++;
+        if (fwdbe_new[b]) begin
+          `CHK(fwdd_new[8*b+:8] == fwdd_ref[8*b+:8], $sformatf("FWD byte %0d data new=%h ref=%h ld a%h t%0d %s", b, fwdd_new[8*b+:8], fwdd_ref[8*b+:8], load_paddr_i, load_trans_id_i, qdump("state")))
+        end else begin
+          fwd_stall_instead++;
+          if (!cbo_mode) begin
+            `CHK(pom_new, $sformatf("FWD byte %0d forwarded by ref, neither forwarded nor stalled by new (pa=%h ldtid=%0d)", b, load_paddr_i, load_trans_id_i))
+          end
+        end
+      end else if (fwdbe_new[b]) begin
+        fwd_extra_bytes++;
+        if (!cbo_mode) begin
+          `CHK(u_new.u.commit_stage_q || new_cq_cover[b] || flush_q || (|cancel_q) || flush_i || (|cancelled_mask_i), $sformatf("FWD extra byte %0d outside an explicable window (pa=%h ldtid=%0d) %s", b, load_paddr_i, load_trans_id_i, qdump("state")))
+        end
+      end
+    end
+    // READY / EMPTY / COMMIT-READY conservativeness
+    `CHK(!empty_new || (u_ref.u.speculative_status_cnt_q == 0), "EMPTY new=1 while the previous semantics hold a speculative store")
+    `CHK(!no_st_new || !u_new.u.commit_stage_q, "NOSTPEND new=1 while a commit is staged")
+    `CHK(!cready_new || cready_del, $sformatf("CREADY new=1 del=0: ref cq=%0d new cq=%0d cstg=%b ref_rp=%0d ref_wp=%0d new_rp=%0d new_wp=%0d ref_head v=%b wr=%b cbo=%0d new_head v=%b wr=%b cbo=%0d gnt=%b rvalid=%b stall=%b",
+         u_ref.u.commit_status_cnt_q, u_new.u.commit_status_cnt_q, u_new.u.commit_stage_q,
+         u_ref.u.commit_read_pointer_q, u_ref.u.commit_write_pointer_q, u_new.u.commit_read_pointer_q, u_new.u.commit_write_pointer_q,
+         u_ref.u.commit_queue_q[u_ref.u.commit_read_pointer_q].valid, u_ref.u.commit_queue_q[u_ref.u.commit_read_pointer_q].wait_rvalid, u_ref.u.commit_queue_q[u_ref.u.commit_read_pointer_q].cbo_op,
+         u_new.u.commit_queue_q[u_new.u.commit_read_pointer_q].valid, u_new.u.commit_queue_q[u_new.u.commit_read_pointer_q].wait_rvalid, u_new.u.commit_queue_q[u_new.u.commit_read_pointer_q].cbo_op,
+         req_port_i.data_gnt, req_port_i.data_rvalid, stall_st_pending_i))
+    // RVFI: commit at t names the entry popped at t+1
+    if (commit_q) begin
+      `CHK(rvfi_q == u_new.u.speculative_queue_q[u_new.u.speculative_read_pointer_q].address, $sformatf("RVFI %h != popped %h", rvfi_q, u_new.u.speculative_queue_q[u_new.u.speculative_read_pointer_q].address))
+    end
+    if (valid_i) pushes++;
+    if (commit_i) commits++;
+    if (|cancelled_mask_i) cancels++;
+    if (flush_i) flushes++;
+    if (u_new.u.commit_stage_q) stage_commits++;
+    if (int'(u_new.u.speculative_status_cnt_q) > int'(max_occ)) max_occ = u_new.u.speculative_status_cnt_q;
+    if (errors > 12) $fatal(1, "FAIL tb_sb_stage errors=%0d", errors);
+    if (cyc == 300000) begin
+      if (errors != 0 || pushes < 1000 || commits < 1000 || cancels < 100 || flushes < 20 || fwd_ref_bytes < 1000 || max_occ < DepthSpec)
+        $fatal(1, "FAIL/vacuous pushes=%0d commits=%0d cancels=%0d flushes=%0d fwd_bytes=%0d max_occ=%0d errors=%0d",
+               pushes, commits, cancels, flushes, fwd_ref_bytes, max_occ, errors);
+      $display("PASS tb_sb_stage mode=%s cycles=%0d pushes=%0d commits=%0d cancels=%0d flushes=%0d fwd_bytes=%0d stall_instead=%0d extra_bytes=%0d max_occ=%0d staged_commits=%0d errors=0",
+               cbo_mode ? "cbo" : "plain", cyc, pushes, commits, cancels, flushes, fwd_ref_bytes, fwd_stall_instead, fwd_extra_bytes, max_occ, stage_commits);
+      $finish;
+    end
+  end
+endmodule
diff --git a/verif/tb/core/store_buffer_sbs/wrap_stage.sv b/verif/tb/core/store_buffer_sbs/wrap_stage.sv
new file mode 100644
index 000000000..79674484a
--- /dev/null
+++ b/verif/tb/core/store_buffer_sbs/wrap_stage.sv
@@ -0,0 +1,116 @@
+// Copyright 2026 Etienne Cimon
+// SPDX-License-Identifier: MIT
+// Wrapper for the A138 staged store buffer (tb_sb_stage): sb_wrap_new's
+// ports, no legacy interface assumptions, RVFI address unmasked.
+module sb_wrap_stage
+  import ariane_pkg::*;
+#(
+    parameter config_pkg::cva6_cfg_t CVA6Cfg = build_config_pkg::build_config(cva6_config_pkg::cva6_cfg),
+    localparam type cbo_t = logic [7:0],
+    localparam type dcache_req_i_t = struct packed {
+      logic [CVA6Cfg.DCACHE_INDEX_WIDTH-1:0] address_index;
+      logic [CVA6Cfg.DCACHE_TAG_WIDTH-1:0]   address_tag;
+      logic [CVA6Cfg.XLEN-1:0]               data_wdata;
+      logic [CVA6Cfg.DCACHE_USER_WIDTH-1:0]  data_wuser;
+      logic                                  data_req;
+      logic                                  data_we;
+      logic [(CVA6Cfg.XLEN/8)-1:0]           data_be;
+      logic [1:0]                            data_size;
+      logic [CVA6Cfg.DcacheIdWidth-1:0]      data_id;
+      logic                                  kill_req;
+      logic                                  tag_valid;
+      cbo_t                                  cbo_op;
+    },
+    localparam type dcache_req_o_t = struct packed {
+      logic                                 data_gnt;
+      logic                                 data_rvalid;
+      logic [CVA6Cfg.DcacheIdWidth-1:0]     data_rid;
+      logic [CVA6Cfg.XLEN-1:0]              data_rdata;
+      logic [CVA6Cfg.DCACHE_USER_WIDTH-1:0] data_ruser;
+    }
+) (
+    input logic clk_i,  // Clock
+    input logic rst_ni,  // Asynchronous reset active low
+    input logic flush_i,  // full flush: drop all speculative stores
+    // FSE S4: younger-only cancel (SB cancelled TIDs); does not touch commit queue
+    input logic [CVA6Cfg.NR_SB_ENTRIES-1:0] cancelled_mask_i,
+    // Scoreboard issued mask: an OoO speculative entry is a reservation whose
+    // scoreboard slot must still be live (assertion only)
+    input logic [CVA6Cfg.NR_SB_ENTRIES-1:0] sb_live_i,
+    input logic stall_st_pending_i,  // Stall issuing non-speculative request
+    output logic         no_st_pending_o, // non-speculative queue is empty (e.g.: everything is committed to the memory hierarchy)
+    output logic         store_buffer_empty_o, // there is no store pending in neither the speculative unit or the non-speculative queue
+
+    input  logic [11:0]  page_offset_i,         // load VA/PA[11:0] (always available)
+    // R3a: full load paddr when DTLB has translated; required for exact STQ match.
+    input  logic [CVA6Cfg.PLEN-1:0] load_paddr_i,
+    input  logic                    load_paddr_valid_i,
+    // U5.4 OoO program-order keys. A store may only be observed by a load that
+    // follows it in program order, and stores must reach memory in that order.
+    // Index order is not age once scoreboard slots are reused, so age is the
+    // circular trans_id distance from the oldest live instruction. Both inputs
+    // are inert when OoOEn is 0.
+    input  logic [CVA6Cfg.TRANS_ID_BITS-1:0] load_trans_id_i,
+    input  logic [CVA6Cfg.TRANS_ID_BITS-1:0] commit_trans_id_i,
+    // T6b-4b: the scoreboard reclaim pointer — the oldest live slot. This is
+    // the program-age anchor for the speculative queue's circular ordering;
+    // commit_trans_id_i stays the *committing* tid (port-0 slot) for the
+    // head-match gate below. Aliases commit_trans_id_i under legacy order.
+    input  logic [CVA6Cfg.TRANS_ID_BITS-1:0] oldest_live_tid_i,
+    // N1d: the commit head is an unpublished load (phys_pending — it needs
+    // this LSU to make progress). A speculative-queue stall can only clear
+    // through commit, so holding a younger load on it is a circular wait;
+    // release it and let the LSQ phys_replay scan arbitrate any true alias
+    // when the released load publishes its physical address. Constant 0
+    // unless the OoO physical-tracking policy (COH_OOO) is live.
+    input  logic                          head_phys_pending_i,
+    // T6b: hart of the querying load. Under OoO multi-hart a load forwards
+    // only from its OWN hart's speculative stores; a peer hart's store is not
+    // visible until commit. Constant-0 otherwise (single hart / in-order).
+    input  logic [$clog2(CVA6Cfg.NrHarts > 1 ? CVA6Cfg.NrHarts : 2)-1:0] load_hart_i,
+    // R3a cont.13: D$ write buffer empty — sticky [11:0] match must outlive
+    // STQ→wbuffer handoff so post-return loads of *nextoffset see the store.
+    input  logic                    dcache_wbuffer_empty_i,
+    output logic         page_offset_matches_o, // hazard: stall load until STQ drains / forward
+    // T33: the live match comes from the SPECULATIVE queue only (no committed
+    // entry, no sticky drain window). Such a store can only leave after every
+    // older instruction retires, so a load parked on it in WAIT_PAGE_OFFSET
+    // must not hold the load unit against an older load -- the load unit
+    // replays it instead (see load_unit.sv).
+    output logic         page_offset_spec_only_o,
+    // R3a: store→load data forward (byte-merge, oldest→youngest). When a load's
+    // BE is fully covered, the load unit may complete without a D$ request.
+    output logic                              st_fwd_valid_o,
+    output logic [CVA6Cfg.XLEN-1:0]           st_fwd_data_o,
+    output logic [(CVA6Cfg.XLEN/8)-1:0]       st_fwd_be_o,
+
+    input logic commit_i,  // commit the instruction which was placed there most recently
+    output logic commit_ready_o,  // commit queue is ready to accept another commit request
+    output logic ready_o,  // the store queue is ready to accept a new request
+                           // it is only ready if it can unconditionally commit the instruction, e.g.:
+                           // the commit buffer needs to be empty
+    input logic valid_i,  // this is a valid store
+    input  logic         valid_without_flush_i, // just tell if the address is valid which we are current putting and do not take any further action
+
+    input  logic [CVA6Cfg.PLEN-1:0]  paddr_i,         // physical address of store which needs to be placed in the queue
+    input  logic [CVA6Cfg.TRANS_ID_BITS-1:0] trans_id_i, // scoreboard tid (FSE S4 younger cancel)
+    // T6b: hart of the arriving store, recorded on its speculative entry.
+    input  logic [$clog2(CVA6Cfg.NrHarts > 1 ? CVA6Cfg.NrHarts : 2)-1:0] st_hart_i,
+    output logic [CVA6Cfg.PLEN-1:0] rvfi_mem_paddr_o,
+    input logic [CVA6Cfg.XLEN-1:0] data_i,  // data which is placed in the queue
+    input logic [(CVA6Cfg.XLEN/8)-1:0] be_i,  // byte enable in
+    input logic [1:0] data_size_i,  // type of request we are making (e.g.: bytes to write)
+    input cbo_t cbo_op_i,  // type of cache block operation
+
+    // D$ interface
+    input  dcache_req_o_t req_port_i,
+    output dcache_req_i_t req_port_o
+);
+  logic [CVA6Cfg.PLEN-1:0] paddr_raw;
+  store_buffer #(.CVA6Cfg(CVA6Cfg), .dcache_req_i_t(dcache_req_i_t), .dcache_req_o_t(dcache_req_o_t), .cbo_t(cbo_t)) u (.rvfi_mem_paddr_o(paddr_raw), .*);
+  // A138: the RVFI address is compared against the entry popped next cycle
+  // by tb_sb_stage, so it is passed through unmasked; the staged design's
+  // interface rules (push with a staged pop pending, commit of a staged
+  // store) are the module's own clocked assertions, not the sb_wrap_new ones.
+  assign rvfi_mem_paddr_o = paddr_raw;
+endmodule
