diff --git a/verif/tb/core/tb_g6lc_iq_stgate.sv b/verif/tb/core/tb_g6lc_iq_stgate.sv
new file mode 100644
index 000000000..a9b6d4e6e
--- /dev/null
+++ b/verif/tb/core/tb_g6lc_iq_stgate.sv
@@ -0,0 +1,235 @@
+// SPDX-License-Identifier: CERN-OHL-S-2.0 OR LicenseRef-GSys-Commercial
+// Copyright (c) 2026 Etienne Cimon
+//
+// A145 witness: the issue queue's staged store-age gate (CVA6Cfg.IqStagedStoreGate).
+//
+// Random dispatch of ALU/LOAD/STORE ops with in-order trans_ids, a model LSQ
+// (a store is unresolved from the cycle after dispatch until a random delay
+// after it issues), writeback producers, a commit pointer that follows the
+// oldest live op, random acks and memory stalls. Every cycle, for every
+// issued load without a dispatch-time bypass, the EXACT current-cycle rule
+// is checked: no unresolved store older than the load exists now
+// (IQ_STGATE_SAFETY). Operand readiness and store age order are checked for
+// every issue. Liveness: the oldest op that is issuable by the exact rule
+// must issue within LIVENESS_BOUND acked cycles (the staged gate adds at most
+// one). +oracle_negative hides the unresolved mask from the DUT while the
+// checker keeps it: the safety check must then fail (nonzero exit).
+module tb_g6lc_iq_stgate;
+  import ariane_pkg::*;
+  parameter int NP = 2, DEPTH = 16, CYCLES = 200000, LIVENESS_BOUND = 3;
+  localparam int TW = 4, NSB = 16;
+  function automatic config_pkg::cva6_cfg_t configuration();
+    config_pkg::cva6_cfg_t c = config_pkg::cva6_cfg_empty;
+    c.NrIssuePorts = NP; c.NrWbPorts = 2; c.NR_SB_ENTRIES = NSB; c.TRANS_ID_BITS = TW; c.RVA = 1;
+    c.IqStagedStoreGate = 1'b1;
+    return c;
+  endfunction
+  localparam config_pkg::cva6_cfg_t C = configuration();
+  typedef struct packed {fu_t fu; fu_op op; logic [TW-1:0] trans_id; logic hart_id; logic [31:0] pc;} sbe_t;
+
+  logic clk = 0, rst_n = 0, flush = 0, mem_stall = 0, full, empty;
+  logic [NSB-1:0] cancel = '0, st_unresolved = '0, st_live = '0, st_unres_dut;
+  logic [TW-1:0] commit_ptr = '0;
+  logic [NP-1:0] dv = '0, da, iv, ia = '0, r1 = '0, r2 = '0, bypass = '0;
+  sbe_t [NP-1:0] ds, is;
+  logic [NP-1:0][31:0] di = '0, ii;
+  logic [NP-1:0][3:0] p1 = '0, p2 = '0, pd = '0, ip;
+  logic [1:0] wv = '0;
+  logic [1:0][3:0] wp = '0;
+  bit negative;
+  logic [NP-1:0] iv_s, da_s;
+  sbe_t [NP-1:0] is_s;
+  int unsigned seed = 1, cyc = 0, issued = 0, issued_ld = 0, issued_st = 0, dispatched = 0, checks = 0;
+
+  // +oracle_negative: the DUT sees no unresolved store; the checker does
+  assign st_unres_dut = negative ? '0 : st_unresolved;
+
+  g6lc_iq #(.CVA6Cfg(C), .DEPTH(DEPTH), .PRF_W(4), .scoreboard_entry_t(sbe_t)) dut (
+    .clk_i(clk), .rst_ni(rst_n), .flush_i(flush), .cancelled_mask_i(cancel),
+    .disp_valid_i(dv), .disp_sbe_i(ds), .disp_orig_i(di), .disp_prs1_i(p1), .disp_prs2_i(p2), .disp_prd_i(pd),
+    .disp_fprs1_i('0), .disp_fprs2_i('0), .disp_fprs3_i('0),
+    .disp_fpr_rs1_i('0), .disp_fpr_rs2_i('0), .disp_fpr_rs3_i('0),
+    .disp_rs3_ready_i('1), .fwb_valid_i('0), .fwb_prd_i('0),
+    .disp_rs1_ready_i(r1), .disp_rs2_ready_i(r2), .disp_may_bypass_i(bypass), .disp_ack_o(da), .full_o(full), .empty_o(empty),
+    .wb_valid_i(wv), .wb_prd_i(wp),
+    .issue_sbe_o(is), .issue_orig_o(ii), .issue_prd_o(ip), .issue_valid_o(iv), .issue_ack_i(ia), .mem_stall_i(mem_stall),
+    .st_live_mask_i(st_live), .st_unresolved_mask_i(st_unres_dut), .st_hart_mask_i(st_live), .commit_ptr_i(commit_ptr), .sb_live_i('1));
+
+  // ---- model per trans_id
+  typedef struct {
+    bit live, in_iq, issued, wb_done, is_ld, is_st, bypass, rs2_wait;
+    logic [3:0] rs2_tag;
+    int unsigned resolve_at, wb_at, eligible_since;
+  } op_t;
+  op_t m [0:NSB-1];
+  logic [TW-1:0] alloc_ptr = '0;
+  int unsigned n_live = 0;
+
+  function automatic bit older(input logic [TW-1:0] a, input logic [TW-1:0] b);
+    return g6lc_ooo_pkg::ooo_age_older(TW, 32'(a), 32'(b), 32'(commit_ptr));
+  endfunction
+  // rs2 producer done (or writing back this very cycle: the queue wakes on
+  // the pulse and may issue the consumer in the same cycle)?
+  function automatic bit src_done(input int t);
+    if (!m[t].rs2_wait) return 1;   // woken earlier (sticky, as the queue's rs2_rdy)
+    for (int w = 0; w < 2; w++) if (wv[w] && wp[w] == m[t].rs2_tag) return 1;
+    return 0;
+  endfunction
+  function automatic bit older_unresolved_now(input int t);
+    for (int s = 0; s < NSB; s++)
+      if (st_unresolved[s] && older(s[3:0], t[3:0])) return 1;
+    return 0;
+  endfunction
+  // exact-rule issuable (ignores port count)
+  function automatic bit issuable(input int t);
+    bit st_older_in_q;
+    if (!m[t].live || !m[t].in_iq || m[t].issued) return 0;
+    if (!src_done(t)) return 0;
+    if (m[t].is_ld && (mem_stall || (!m[t].bypass && older_unresolved_now(t)))) return 0;
+    if (m[t].is_st) begin
+      st_older_in_q = 0;
+      for (int s = 0; s < NSB; s++) if (m[s].live && m[s].in_iq && !m[s].issued && m[s].is_st && s != t && older(s[3:0], t[3:0])) st_older_in_q = 1;
+      if (st_older_in_q) return 0;
+    end
+    return 1;
+  endfunction
+
+  task automatic tick; clk = 1; #2; clk = 0; #2; endtask
+
+  initial begin
+    negative = $test$plusargs("oracle_negative");
+    if (!$value$plusargs("seed=%d", seed)) seed = 1;
+    void'($urandom(seed));
+    for (int t = 0; t < NSB; t++) begin m[t].live = 0; m[t].in_iq = 0; end
+    #1; tick(); rst_n = 1; #1;
+    for (cyc = 0; cyc < CYCLES; cyc++) begin
+      // ---------------- drive (inputs settle before the edge)
+      dv = '0; ds = '0; r1 = '1; r2 = '0; p1 = '0; p2 = '0; pd = '0; bypass = '0; wv = '0; wp = '0; di = '0;
+      mem_stall = ($urandom % 16 == 0);
+      // dispatch a prefix of the ports (the IQ accepts a prefix when slots
+      // run out, and trans_ids are allocated in order) when the queue has
+      // room and the tids are free
+      begin
+        int n_offer = $urandom % (NP + 2);
+        if (n_offer > NP) n_offer = NP;
+        for (int p = 0; p < NP; p++) begin
+          logic [TW-1:0] t = alloc_ptr + TW'(p);
+          if (p < n_offer && !full && !m[t].live && n_live + p < NSB - 1) begin
+          int kind = $urandom % 5;   // 0,1: ALU  2,3: LOAD  4: STORE
+          dv[p] = 1;
+          ds[p] = '{fu: (kind >= 4) ? STORE : (kind >= 2) ? LOAD : ALU,
+                    op: (kind >= 4) ? SD : (kind >= 2) ? LD : ADD,
+                    trans_id: t, hart_id: 1'b0, pc: 32'h1000 + 32'(t) * 4};
+          di[p] = 32'(t); pd[p] = t; p1[p] = 0;
+          // rs2: ready, or wait on a random live producer not yet written back
+          begin
+            int cand = -1;
+            // physical 0 is the integer no-destination tag: never a producer
+            for (int s = 1; s < NSB; s++) if (m[s].live && !m[s].wb_done && ($urandom % 3 == 0)) cand = s;
+            if (cand >= 0 && ($urandom % 2)) begin r2[p] = 0; p2[p] = cand[3:0]; end
+            else begin r2[p] = 1; p2[p] = 0; end
+          end
+          bypass[p] = (kind >= 2 && kind < 4) && ($urandom % 5 == 0);
+          end else begin
+            n_offer = p;   // keep the offered set a prefix
+          end
+        end
+      end
+      // writebacks for issued ops whose time has come
+      begin
+        int w = 0;
+        for (int s = 0; s < NSB && w < 2; s++)
+          if (m[s].live && m[s].issued && !m[s].wb_done && m[s].wb_at <= cyc) begin
+            wv[w] = 1; wp[w] = s[3:0]; w++;
+          end
+      end
+      ia = {NP{1'b1}};
+      if ($urandom % 10 == 0) ia[0] = 0;
+      if ($urandom % 10 == 0 && NP > 1) ia[1] = 0;
+      #1;
+      // ---------------- check the selection (before the edge; pure function of state)
+      for (int p = 0; p < NP; p++) begin
+        if (iv[p]) begin
+          int t = is[p].trans_id;
+          if (!m[t].live || !m[t].in_iq || m[t].issued) $fatal(1, "IQ_STGATE_PHANTOM cyc=%0d port=%0d tid=%0d", cyc, p, t);
+          if (!src_done(t)) $fatal(1, "IQ_STGATE_OPERANDS cyc=%0d tid=%0d", cyc, t);
+          if (m[t].is_ld && !m[t].bypass && older_unresolved_now(t))
+            $fatal(1, "IQ_STGATE_SAFETY cyc=%0d load tid=%0d issued past an older unresolved store (mask=%h cp=%0d)", cyc, t, st_unresolved, commit_ptr);
+          if (m[t].is_ld && mem_stall) $fatal(1, "IQ_STGATE_MEMSTALL cyc=%0d tid=%0d", cyc, t);
+          if (m[t].is_st)
+            for (int s = 0; s < NSB; s++)
+              if (m[s].live && m[s].in_iq && !m[s].issued && m[s].is_st && s != t && older(s[3:0], t[3:0]) && !(iv[0] && is[0].trans_id == s[3:0] && p == 1))
+                $fatal(1, "IQ_STGATE_STORE_ORDER cyc=%0d tid=%0d older store %0d still queued", cyc, t, s);
+          checks++;
+        end
+      end
+      // liveness: the oldest exact-rule issuable op must issue soon (acked cycles only)
+      begin
+        int oldest = -1;
+        for (int t = 0; t < NSB; t++)
+          if (issuable(t) && (oldest < 0 || older(t[3:0], oldest[3:0]))) oldest = t;
+        if (oldest >= 0 && ia[0]) begin
+          bit taken = 0;
+          for (int p = 0; p < NP; p++) if (iv[p] && ia[p] && is[p].trans_id == oldest[3:0]) taken = 1;
+          if (!taken) begin
+            m[oldest].eligible_since++;
+            if (m[oldest].eligible_since > LIVENESS_BOUND)
+              $fatal(1, "IQ_STGATE_LIVENESS cyc=%0d tid=%0d issuable for %0d acked cycles", cyc, oldest, m[oldest].eligible_since);
+          end else m[oldest].eligible_since = 0;
+        end
+      end
+      // ---------------- edge (sample the pre-edge decisions first: the
+      // outputs follow the new state as soon as the edge has passed)
+      iv_s = iv; is_s = is; da_s = da;
+      tick();
+      // ---------------- model update (what the DUT just did)
+      for (int p = 0; p < NP; p++) begin
+        if (iv_s[p] && ia[p]) begin
+          int t = is_s[p].trans_id;
+          m[t].issued = 1; m[t].in_iq = 0; issued++;
+          m[t].wb_at = cyc + 1 + ($urandom % 3);
+          if (m[t].is_ld) issued_ld++;
+          if (m[t].is_st) begin issued_st++; m[t].resolve_at = cyc + 1 + ($urandom % 3); end
+        end
+      end
+      for (int p = 0; p < NP; p++) begin
+        if (dv[p] && da_s[p]) begin
+          int t = ds[p].trans_id;
+          m[t].live = 1; m[t].in_iq = 1; m[t].issued = 0; m[t].wb_done = 0; m[t].eligible_since = 0;
+          m[t].is_ld = (ds[p].fu == LOAD); m[t].is_st = (ds[p].fu == STORE); m[t].bypass = bypass[p];
+          m[t].rs2_wait = !r2[p]; m[t].rs2_tag = p2[p];
+          st_live[t] <= m[t].is_st; st_unresolved[t] <= m[t].is_st;   // LSQ: allocated at dispatch, unresolved
+          n_live++; dispatched++;
+        end else if (dv[p] && !da_s[p]) begin
+          // refused: leave the tid free (dispatch is all-or-nothing per port here)
+        end
+      end
+      alloc_ptr = alloc_ptr + TW'($countones(dv & da_s));
+      for (int w = 0; w < 2; w++) if (wv[w]) m[wp[w]].wb_done = 1;
+      // wakeups are sticky per waiting entry (newcomers included: same-cycle capture)
+      for (int t = 0; t < NSB; t++)
+        if (m[t].live && m[t].in_iq && m[t].rs2_wait)
+          for (int w = 0; w < 2; w++) if (wv[w] && wp[w] == m[t].rs2_tag) m[t].rs2_wait = 0;
+      for (int s = 0; s < NSB; s++) begin
+        if (m[s].live && m[s].is_st && m[s].issued && st_unresolved[s] && m[s].resolve_at <= cyc) st_unresolved[s] <= 0;
+      end
+      // retire in order: the oldest live op leaves once issued and written back (stores: resolved)
+      begin
+        bit progress = 1;
+        while (progress) begin
