     bit          SpeculativeSb;
     bit          DeepSpecEn;          // FSE depth plane (STQ/load/ckpt floors)
+    bit          IqStagedStoreGate;   // A145 staged IQ store-age gate
 
     int unsigned NrALUs;
     bit          ALUBypass;
