@@ -711,6 +711,11 @@ package config_pkg;
     // FSE: deep speculation depth plane (architecture/speculative-execution/)
     // 0 = legacy STQ depth 4 + package-stated buffers; 1 = auto floors + deeper STQ
     bit          DeepSpecEn;
+    // A145: issue-queue store-age gate for loads evaluated one cycle ahead
+    // (registered per slot; the one-cycle-old unresolved-store view is
+    // completed by the stores still queued). A load blocked by an older
+    // unresolved store is released one cycle after the store resolves.
+    bit          IqStagedStoreGate;
     int unsigned RobEntries;          // ROB depth (0 → NrScoreboardEntries when OoOEn)
