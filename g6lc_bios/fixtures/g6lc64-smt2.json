{
  "schema_version": 1,
  "profile": "full",
  "product": "g6lc64_smt2",
  "isa": {
    "xlen": 64,
    "march": "rv64imafdc",
    "mmu": "sv39",
    "extensions": {
      "c": "live",
      "v": "absent",
      "h": "absent",
      "f": "live",
      "d": "live"
    }
  },
  "harts": { "count": 2, "cores": 1, "threads": 2 },
  "core": { "issue_ports": 2, "ooo": false, "stream": false },
  "uncore": { "clint": true, "plic": true },
  "kernel": {
    "shape": "zeal",
    "gr": { "enable": true, "w": 640, "h": 480, "colors": 16, "backend": "virtio-gpu" },
    "proxy": {
      "enable": true,
      "link": "hdmi",
      "dpi": 192,
      "fps": 0,
      "detected_hz": 120,
      "high_w": 1920,
      "high_h": 1080,
      "gl": true
    },
    "tls": { "enable": true, "https": true, "rsa": true, "ecdsa": true, "certificates": true },
    "http": { "enable": true, "http1": true, "http2": true, "proxy_js": true },
    "params": {
      "clocks": true,
      "edk2": true,
      "uboot": true,
      "bootloader": true,
      "cpu_hz": 1000000000,
      "uart_baud": 115200,
      "next": "opensbi"
    },
    "ui": "svelte-d",
    "wasm": { "enable": true, "jit": true },
    "display": "html-js"
  },
  "connectors": {
    "core": ["sbi", "pmu", "opp"],
    "apu": ["uart", "gpio", "spi"],
    "uncore": ["clint", "plic"]
  },
  "peripherals": [
    { "id": "uart0", "class": "uart", "model": "ns16550", "base": "0x10000000" },
    { "id": "spi0", "class": "blk", "model": "sifive-spi-nor", "base": "0x20000000" }
  ],
  "memory": {
    "dram_base": "0x80000000",
    "dram_len": "0x40000000",
    "text_offset": "0x200000"
  },
  "entry": { "hotkey": "DEL", "timeout_ms": 2000 },
  "holyc": {
    "fast_init": true,
    "dual_band": {
      "uart": true,
      "tcp": { "enable": true, "host_port": 2222, "guest_port": 22, "proto": "holyc-repl" }
    }
  },
  "postboot": {
    "enable": "runtime",
    "access": "kvm",
    "backends": ["html-js", "ssh-holyc"],
    "immutable": ["config", "keys", "boot-policy"],
    "power": ["reboot", "shutdown", "wakeup"],
    "always_on_domain": true
  },
  "net_expose": {
    "mode": "until-delegate",
    "via": "adapter",
    "web": true,
    "ssh_holyc": true
  },
  "loopback": {
    "enable": true,
    "transport": "mbox",
    "compatible": "gsys,g6lc-bios-mbox",
    "base": "0x10100000",
    "len": "0x1000",
    "irq": 3,
    "chardev": "/dev/g6lc-bios"
  }
}
