// Generated Endpoints.ZC — kernel HTTP (http1=1 http2=1); not SvelteKit
U0 RegisterEndpoint(U8 *path, U8 *method)
{
	Print("EP-REG %s %s\n", method, path);
}
U0 HttpHandle(U8 *raw)
{
	Print("HTTP-OK\n");
}
U0 KernelGet(U8 *path)
{
	Print("KERNEL-GET %s\n", path);
}
U0 BiosClocks() { KernelGet("/bios/clocks"); }
U0 FlashImage(U8 *img)
{
	Print("FLASH-IMAGE %s\n", img);
}
U0 BiosUpdate()
{
	Print("BIOS-UPDATE self\n");
}
