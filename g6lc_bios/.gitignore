# Rust build
/target/
**/target/

# JS / D / CMake caches (kernel-spec and browser-ui clones)
**/node_modules/
**/.dub/
**/CMakeFiles/
**/.next/
**/third_party/

# Host binaries that ride along in spec forks
**/*.exe
**/*.exe.*
**/*.pdb
**/*.ilk
**/*.obj

# Generated payload images (sources under out/zeal stay)
/out/*.elf
/out/*.ppm
/out/*.glsl
/out/*.png
/out/*.kra
/out/render/

# The pinned LDC download is ignored by browser-ui/toolchains/.gitignore, which
# keeps ldc.lock.json as the single checked-in source of truth.

# Asyncify / wasm-opt inspection artifacts, not shipped.
/browser-ui/svelte-engine-ws/public/bios-ui-asyncify-inspect.*

# Python
**/__pycache__/
*.py[cod]

# Pinned Electric PGlite npm dist (wasm+initdb+data). Pin is pins.toml [pglite.dist].
/.tools/pglite-dist/

# Temporary rename of nested spec-fork .git dirs while vendoring
**/.git.nested.bak/
