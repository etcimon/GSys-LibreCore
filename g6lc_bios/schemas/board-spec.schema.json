{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsys.dev/g6lc-bios/board-spec.schema.json",
  "title": "g6lc_bios BoardSpec",
  "type": "object",
  "required": ["schema_version", "isa"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "product": { "type": "string" },
    "isa": {
      "type": "object",
      "properties": {
        "xlen": { "enum": [32, 64] },
        "march": { "type": "string" },
        "mmu": { "type": "string" },
        "extensions": {
          "type": "object",
          "additionalProperties": { "enum": ["live", "stub", "absent"] }
        }
      }
    },
    "kernel": {
      "type": "object",
      "properties": {
        "ui": { "enum": ["html-js", "svelte-d"] },
        "tasking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enable": { "type": "boolean", "default": false },
            "ui_hart": { "type": "integer", "minimum": 0, "maximum": 63 },
            "max_tasks": { "type": "integer", "minimum": 3, "maximum": 256 },
            "max_workers": { "type": "integer", "minimum": 0, "maximum": 254 },
            "stack_bytes": { "type": "integer", "minimum": 4096, "maximum": 1048576, "multipleOf": 16 }
          }
        },
        "browser": {
          "type": "object",
          "properties": {
            "js": { "enum": ["aot", "off", "none"] },
            "ui": { "enum": ["html-js", "svelte-d"] },
            "start_menu": { "enum": ["main", "cpu", "memory", "uncore", "devices", "boot", "settings"] },
            "wasm": { "$ref": "#/$defs/wasm" }
          }
        },
        "wasm": { "$ref": "#/$defs/wasm" }
      }
    },
    "connectors": { "type": "object" },
    "peripherals": { "type": "array" },
    "memory": { "type": "object" },
    "harts": { "type": "object" },
    "entry": { "type": "object" },
    "holyc": { "type": "object" },
    "postboot": { "type": "object" },
    "loopback": { "type": "object" },
    "net_expose": { "type": "object" },
    "faces": { "type": "object" }
  },
  "$defs": {
    "wasm": {
      "type": "object",
      "properties": {
        "enable": { "type": "boolean" },
        "jit": { "type": "boolean" }
      }
    }
  }
}
