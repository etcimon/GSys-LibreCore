{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsys.dev/g6lc-bios/board-spec.schema.json",
  "title": "g6lc_bios BoardSpec",
  "type": "object",
  "required": ["schema_version", "isa"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "product": { "type": "string" },
    "isa": {
      "type": "object",
      "properties": {
        "xlen": { "enum": [32, 64] },
        "march": { "type": "string" },
        "mmu": { "type": "string" },
        "extensions": {
          "type": "object",
          "additionalProperties": { "enum": ["live", "stub", "absent"] }
        }
      }
    },
    "kernel": {
      "type": "object",
      "properties": {
        "ui": { "enum": ["html-js", "svelte-d"] },
        "tasking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enable": { "type": "boolean", "default": false },
            "ui_hart": { "type": "integer", "minimum": 0, "maximum": 63 },
            "max_tasks": { "type": "integer", "minimum": 3, "maximum": 256 },
            "max_workers": { "type": "integer", "minimum": 0, "maximum": 254 },
            "stack_bytes": { "type": "integer", "minimum": 4096, "maximum": 1048576, "multipleOf": 16 }
          }
        },
        "browser": {
          "type": "object",
          "properties": {
            "js": { "enum": ["aot", "off", "none"] },
            "ui": { "enum": ["html-js", "svelte-d"] },
            "start_menu": { "enum": ["main", "cpu", "memory", "uncore", "devices", "boot", "settings"] },
            "wasm": { "$ref": "#/$defs/wasm" }
          }
        },
        "wasm": { "$ref": "#/$defs/wasm" },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enable": { "type": "boolean", "default": true },
            "persist": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "memory": { "type": "boolean", "default": true },
                "elf": { "type": "boolean", "default": false },
                "usb": { "type": "boolean", "default": false },
                "volume": { "type": "string", "enum": ["fat32", "ntfs", "ext4", ""] }
              }
            },
            "pglite": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "files": { "type": "boolean", "default": false },
                "js": { "type": "boolean", "default": false },
                "embed": { "type": "boolean", "default": false }
              }
            },
            "max_stores": { "type": "integer", "minimum": 1, "maximum": 16 },
            "max_instances": { "type": "integer", "minimum": 1, "maximum": 16 },
            "max_tables": { "type": "integer", "minimum": 1, "maximum": 64 },
            "max_columns": { "type": "integer", "minimum": 1, "maximum": 32 },
            "max_rows": { "type": "integer", "minimum": 1, "maximum": 16384 },
            "max_sql_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
            "max_param_bytes": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "max_result_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "max_tx": { "type": "integer", "const": 1 },
            "max_open": { "type": "integer", "minimum": 1, "maximum": 8 },
            "max_per_purpose": { "type": "integer", "minimum": 1, "maximum": 8 },
            "purposes": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" }
            },
            "names": {
              "type": "array",
              "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" }
            }
          }
        }
      }
    },
    "connectors": { "type": "object" },
    "peripherals": { "type": "array" },
    "memory": { "type": "object" },
    "harts": { "type": "object" },
    "entry": { "type": "object" },
    "holyc": { "type": "object" },
    "postboot": { "type": "object" },
    "loopback": { "type": "object" },
    "net_expose": { "type": "object" },
    "faces": { "type": "object" }
  },
  "$defs": {
    "wasm": {
      "type": "object",
      "properties": {
        "enable": { "type": "boolean" },
        "jit": { "type": "boolean" }
      }
    }
  }
}
