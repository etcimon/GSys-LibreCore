name "svelte-engine-server"
description "svelte-engine host (vibe.0). DUB vibe-0; add-local only when checkouts exist."
copyright "Copyright © 2023-2026, GlobecSys Inc"
authors "Etienne"
dependency "vibe-0" version=">=1.2.2" repository="git+https://github.com/etcimon/vibe.0.git"
dependency "memutils" version=">=1.0.12" repository="git+https://github.com/etcimon/memutils.git"
dependency "botan" version="~>1.13.0"
dependency "openssl" version="~>3.3.4" repository="git+https://github.com/etcimon/openssl.git"
subConfiguration "botan" "full"
subConfiguration "openssl" "library-manual-link"
# botan/full_openssl optional openssl ~>1.1.7 conflicts with vibe-0's openssl 3.3.4.
# dmaxminddb 0.1.2 does not compile on LDC 1.42 (missing bigEndianToNative).
# geoip.d is a stub until that package is updated.
targetType "executable"
targetName "svelte-engine-server"
targetPath "."
sourcePaths "source"
versions "VibeCustomMain" "DisableDebugger" "VibeNoDebug" "SQLite" "TLSGC" "VibeRequestDebugger" "VibeDebugCatchAll" "DeimosOpenSSL_3_0"

# `svelte-d host` / `bun run dev` keep debug. `svelte-d host --release` / `bun run build` strip.
buildType "debug" {
    buildOptions "debugMode" "debugInfo"
}

buildType "release" {
    buildOptions "releaseMode" "optimize" "inline"
    lflags "-strip-all"
    lflags "/OPT:REF" "/OPT:ICF" "/DEBUG:NONE" platform="windows"
}
