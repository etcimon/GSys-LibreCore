# Workspaces and caches
svelte-engine-ws/
**/.svelte-d/
**/.dub/
**/node_modules/
# Ingest fixture: a fake npm svelte package under node_modules/.
!packages/svelte-kit-d/test/fixtures/
!packages/svelte-kit-d/test/fixtures/**
!packages/svelte-kit-d/test/fixtures/**/node_modules/
!packages/svelte-kit-d/test/fixtures/**/node_modules/**

# Local admin-mini fixture for dest npm fall-through (G126).
!packages/svelte-d-kit-admin/node_modules/admin-mini/
!packages/svelte-d-kit-admin/node_modules/admin-mini/**

# CI / setup-placed wasm-opt triples (LICENSE + README stay)
binaryen-build/*/
binaryen-build/dist/
.wasm-opt-binaries-work/
release/
release-seed/

# Built compiler
packages/svelte-d/bin/
packages/svelte-d/lib/
# Generated by bun scripts/pack-engine.ts from the svelte-engine submodule
packages/svelte-d/svelte-engine/
packages/svelte-d/grammar/generator/*.exe
**/*.exe
**/*.pdb
**/*.dll
**/*.exp
**/*.obj
**/*.wasm

# Secrets — never commit
.env
.env.local
**/.env
**/.env.local
!.env.example
!**/.env.example

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
