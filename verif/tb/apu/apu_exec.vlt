`verilator_config
// Vendored FPnew: packed [0:N] ranges, BLKANDNBLK on pipe arrays, width noise.
lint_off -file "*/core/cvfpu/src/*.sv"
lint_off -rule UNOPTFLAT -file "*/vendor/pulp-platform/common_cells/src/lzc.sv"
lint_off -rule BLKANDNBLK -file "*/core/cvfpu/src/fpnew_fma.sv"
lint_off -rule BLKANDNBLK -file "*/core/cvfpu/src/fpnew_divsqrt_multi.sv"
lint_off -rule BLKANDNBLK -file "*/core/cvfpu/src/fpnew_cast_multi.sv"
lint_off -rule BLKANDNBLK -file "*/core/cvfpu/src/fpnew_noncomp.sv"
lint_off -rule BLKANDNBLK -file "*/core/cvfpu/src/fpnew_divsqrt_th_32.sv"
lint_off -rule SELRANGE -file "*/core/cvfpu/src/fpnew_divsqrt_multi.sv"
lint_off -rule UNOPTFLAT -file "*/core/cvfpu/src/fpnew_fma.sv"
lint_off -rule UNOPTFLAT -file "*/core/cvfpu/src/fpnew_divsqrt_th_32.sv"
lint_off -rule UNOPTFLAT -file "*/core/cvfpu/src/fpnew_divsqrt_multi.sv"
lint_off -rule UNOPTFLAT -file "*/core/cvfpu/src/fpnew_cast_multi.sv"
lint_off -rule UNOPTFLAT -file "*/core/cvfpu/src/fpnew_noncomp.sv"
lint_off -rule UNOPTFLAT -file "*/core/cvfpu/src/fpu_div_sqrt_mvp/hdl/control_mvp.sv"
// tc_sram byte-write loop: delayed assign inside for (Verilator
// limitation; generic tech cell, do not edit).
lint_off -rule BLKLOOPINIT -file "*/vendor/pulp-platform/tech_cells_generic/src/rtl/tc_sram.sv"
// Eliminate false UNOPTFLAT combinational loops in vendored lzc and cvfpu
// ready chains (same proven split_var seam as verilator-split-loops.vlt;
// 0 RTL edits, bit-exact, drops hybrid/Active-region re-evaluation to 0).
lint_off -rule SPLITVAR -file "*/vendor/pulp-platform/common_cells/src/lzc.sv"
lint_off -rule SPLITVAR -file "*/core/cvfpu/src/*.sv"
split_var -module "lzc"                   -var "index_nodes"
split_var -module "lzc"                   -var "sel_nodes"
split_var -module "lzc"                   -var "in_tmp"
split_var -module "fpnew_fma"             -var "inp_pipe_ready"
split_var -module "fpnew_fma"             -var "mid_pipe_ready"
split_var -module "fpnew_fma"             -var "out_pipe_ready"
split_var -module "fpnew_fma"             -var "regular_status"
split_var -module "fpnew_divsqrt_th_32"   -var "inp_pipe_ready"
split_var -module "fpnew_divsqrt_th_32"   -var "out_pipe_ready"
split_var -module "fpnew_cast_multi"      -var "inp_pipe_ready"
split_var -module "fpnew_cast_multi"      -var "mid_pipe_ready"
split_var -module "fpnew_cast_multi"      -var "fp_regular_status"
split_var -module "fpnew_noncomp"         -var "inp_pipe_ready"

// Older 5.008 builds unroll index zero before UNSIGNED lint. The inclusive
// bound deliberately includes zero; keep this waiver line-specific.
// (g6lc_apu_shwave.sv W_MLF had the same waiver pinned to a line number
// that moved with every edit above it; the bound is now `c < lcc + 1`.)
lint_off -rule UNSIGNED -file "*/corev_apu/apu/g6lc_apu_objmem.sv" -lines 917
