#version 460
layout(local_size_x = 8) in;
// §12.3 F5 storage-image descriptor array (CTS storage_image_array
// analogue): 4 image2D elements at binding 0, kind=3, indexed by gid/8.
// Each lane uses a UNIQUE texel within its element (j=i%8 -> 8 distinct
// coords in the 4x4 image) so no two invocations race on one texel —
// a shared coord makes load/store ordering undefined (the earlier
// i&3-only coord aliased 8 lanes per texel and produced spurious
// mismatches, NOT an RTL bug).
// imageLoad reads element e's distinct w-seeded texel (read-index
// proof); imageStore writes marker (e+0.5); imageLoad reads it back
// (store-index + store->load coherence through dsc_idx_q).
layout(set = 0, binding = 0, rgba32f) uniform image2D imgs[4];
layout(set = 0, binding = 1) buffer Out { vec4 o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint e = i / 8;
    uint j = i % 8;
    ivec2 c = ivec2(j & 3, j >> 2);   // 8 unique texels per 4x4 element
    vec4 before = imageLoad(imgs[e], c);
    imageStore(imgs[e], c, vec4(float(e) + 0.5));
    vec4 after = imageLoad(imgs[e], c);
    o[i] = before * 1024.0 + after;
}
