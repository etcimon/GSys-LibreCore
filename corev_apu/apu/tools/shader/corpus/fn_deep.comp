#version 460
// G3a-i CallDepth overflow arm: a depth-10 call chain exceeds the
// shwave CallDepth=8 stack — the dispatch must finish DONE_FAULT.
// (recursion is illegal in SPIR-V; depth is static.)
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) buffer Src { uint src[]; };
layout(set = 0, binding = 1) buffer Dst { uint dst[]; };

uint d0(uint x) { return x + 1u; }
uint d1(uint x) { return d0(x) + 1u; }
uint d2(uint x) { return d1(x) + 1u; }
uint d3(uint x) { return d2(x) + 1u; }
uint d4(uint x) { return d3(x) + 1u; }
uint d5(uint x) { return d4(x) + 1u; }
uint d6(uint x) { return d5(x) + 1u; }
uint d7(uint x) { return d6(x) + 1u; }
uint d8(uint x) { return d7(x) + 1u; }
uint d9(uint x) { return d8(x) + 1u; }

void main() {
    uint i = gl_GlobalInvocationID.x;
    dst[i] = d9(src[i]);    // call depth 10 > CallDepth 8
}
