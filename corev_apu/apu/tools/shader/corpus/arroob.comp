#version 460
layout(local_size_x = 8) in;
// §12.3 F5: gid indexes a 4-element descriptor array; elements >= 4
// resolve to the null record and must load as 0 (robust).
layout(set = 0, binding = 0) buffer In { float v[]; } ins[4];
layout(set = 0, binding = 1) buffer Out { float o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    o[i] = ins[i].v[0];
}
