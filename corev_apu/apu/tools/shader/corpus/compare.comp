#version 460
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) buffer Src { vec4 src[]; };
layout(set = 0, binding = 1) buffer Dst { float dst[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 a = src[i];
    vec4 b = src[i + 32u];
    float t = 0.0;
    t += (a.x >  b.y) ? 1.0 : 2.0;
    t += (a.y <  b.z) ? 4.0 : 8.0;
    t += (a.z >= b.w) ? 16.0 : 32.0;
    t += (a.w <= b.x) ? 64.0 : 128.0;
    t += (a.x == a.y) ? 256.0 : 512.0;
    t += (a.z != a.w) ? 1024.0 : 2048.0;
    uint u = uint(trunc(a.x));
    t += float((u == i) ? 1u : 0u);
    t += float((int(u) < int(i)) ? 2u : 0u) + float((u >= i) ? 4u : 0u);
    t += float((int(u) <= 0) ? 8u : 0u) + float((u > i) ? 16u : 0u);
    dst[i] = t;
}
