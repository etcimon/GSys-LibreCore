#version 460
// §7d SFU smoke — log/log2 over the positive domain incl. specials:
// 1 -> 0, the [0.5,2] accurate band, tiny denormals, 0 -> -inf,
// negative -> NaN, +inf -> +inf.  a = src[i], b = src[i+32].
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) buffer Src { vec4 src[]; };
layout(set = 0, binding = 1) buffer Dst { vec4 dst[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 a = src[i];
    vec4 b = src[i + 32u];
    uint o = i * 2u;
    dst[o + 0u] = vec4(log(a.x), log2(a.y), log(b.x), log2(b.y));
    dst[o + 1u] = vec4(log(a.z), log2(a.w), log(b.z), log2(b.w));
}
