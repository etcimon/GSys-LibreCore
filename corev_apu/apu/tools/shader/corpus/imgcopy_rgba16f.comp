#version 450
// SPDX-License-Identifier: MIT
// T3+: R16G16B16A16_SFLOAT (device format 6) storage-image load + store.
// Lane i loads texel (i % 2, i / 2) of a 2x4 rgba16f image — imageLoad
// widens each fp16 channel to fp32 exactly; the SSBO observes the four
// widened fp32 bit patterns per lane (bit-exact decode proof), then
// imageStore writes v+1.0 back so the fp32->fp16 RNE store encode is
// observed on the out=1 image readback.
layout(local_size_x = 8) in;
layout(rgba16f, set = 0, binding = 1) uniform image2D img;
layout(set = 0, binding = 0) buffer Out { uint o[]; };
void main() {
    uint i = gl_LocalInvocationID.x;
    ivec2 p = ivec2(int(i % 2u), int(i / 2u));
    vec4 v = imageLoad(img, p);
    o[i * 4u]      = floatBitsToUint(v.x);
    o[i * 4u + 1u] = floatBitsToUint(v.y);
    o[i * 4u + 2u] = floatBitsToUint(v.z);
    o[i * 4u + 3u] = floatBitsToUint(v.w);
    imageStore(img, p, v + vec4(1.0));
}
