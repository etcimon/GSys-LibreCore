#version 450
// SPDX-License-Identifier: MIT
// T3+: R32_SFLOAT (device format 7) storage-image load + store.
// Lane i loads texel (i % 2, i / 2) of a 2x4 r32f image — imageLoad
// returns the single fp32 channel in .x (yzw read as 0); the SSBO
// observes that widened fp32 bit pattern per lane (bit-exact decode
// proof), then imageStore writes .x+1.0 back so the store is checked
// on the out=1 image readback.
layout(local_size_x = 8) in;
layout(r32f, set = 0, binding = 1) uniform image2D img;
layout(set = 0, binding = 0) buffer Out { uint o[]; };
void main() {
    uint i = gl_LocalInvocationID.x;
    ivec2 p = ivec2(int(i % 2u), int(i / 2u));
    vec4 v = imageLoad(img, p);
    o[i] = floatBitsToUint(v.x);
    imageStore(img, p, vec4(v.x + 1.0, 0.0, 0.0, 0.0));
}
