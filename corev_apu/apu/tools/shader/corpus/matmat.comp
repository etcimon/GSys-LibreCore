#version 460
layout(local_size_x = 32) in;
layout(set = 0, binding = 0) readonly buffer In { float src[]; };
layout(set = 0, binding = 1) writeonly buffer Out { float dst[]; };
void main() {
  uint i = gl_LocalInvocationIndex;
  float a = src[i * 2u];
  float b = src[i * 2u + 1u];
  mat4 m = mat4(a, b, 1.0, 0.0,
                b, a, 0.0, 1.0,
                1.0, 0.5, a, b,
                0.0, 0.25, b, a);
  mat4 n = mat4(2.0, 0.0, 1.0, 0.5,
                0.0, 2.0, 0.0, 1.0,
                1.0, 1.0, 2.0, 0.0,
                0.5, 0.0, 1.0, 2.0);
  mat4 p = m * n;
  mat4 t = transpose(m);
  mat4 o = outerProduct(vec4(a, b, 1.0, 2.0), vec4(1.0, b, a, 0.5));
  mat4 s = 0.5 * p;
  dst[i * 4u]      = p[0][0] + t[1][2] + o[2][0] + s[3][3];
  dst[i * 4u + 1u] = p[1][1] + t[0][3] + o[0][1] + s[0][0];
  dst[i * 4u + 2u] = p[2][2] + t[3][1] + o[1][3] + s[1][1];
  dst[i * 4u + 3u] = p[3][3] + t[2][0] + o[3][2] + s[2][2];
}
