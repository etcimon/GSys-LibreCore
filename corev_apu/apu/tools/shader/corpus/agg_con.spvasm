; agg_con.spvasm - OpCompositeConstruct of a 9-word struct value
; {vec2, float, mat2, float[2]} from a vector, a scalar, a matrix id (one
; column per register row) and a small array value; stored whole.
;   out.v = in[0..1]; out.f = in[2]; out.m = {in[3..4], in[5..6]};
;   out.t = {in[7], 1.5}
; Assembled with `spirv-as --target-env vulkan1.2`.
               OpCapability Shader
               OpMemoryModel Logical GLSL450
               OpEntryPoint GLCompute %main "main" %in_var %out_var
               OpExecutionMode %main LocalSize 4 1 1
               OpDecorate %arr8 ArrayStride 4
               OpDecorate %arr2 ArrayStride 4
               OpDecorate %blk_a Block
               OpMemberDecorate %blk_a 0 Offset 0
               OpDecorate %blk_b Block
               OpMemberDecorate %blk_b 0 Offset 0
               OpMemberDecorate %S 0 Offset 0
               OpMemberDecorate %S 1 Offset 8
               OpMemberDecorate %S 2 ColMajor
               OpMemberDecorate %S 2 MatrixStride 8
               OpMemberDecorate %S 2 Offset 16
               OpMemberDecorate %S 3 Offset 32
               OpDecorate %in_var DescriptorSet 0
               OpDecorate %in_var Binding 0
               OpDecorate %out_var DescriptorSet 0
               OpDecorate %out_var Binding 1
       %void = OpTypeVoid
          %3 = OpTypeFunction %void
      %float = OpTypeFloat 32
       %uint = OpTypeInt 32 0
        %int = OpTypeInt 32 1
      %int_0 = OpConstant %int 0
     %uint_8 = OpConstant %uint 8
     %uint_2 = OpConstant %uint 2
  %float_1_5 = OpConstant %float 1.5
    %v2float = OpTypeVector %float 2
       %mat2 = OpTypeMatrix %v2float 2
       %arr8 = OpTypeArray %float %uint_8
       %arr2 = OpTypeArray %float %uint_2
          %S = OpTypeStruct %v2float %float %mat2 %arr2
      %blk_a = OpTypeStruct %arr8
      %blk_b = OpTypeStruct %S
  %ptr_blk_a = OpTypePointer StorageBuffer %blk_a
  %ptr_blk_b = OpTypePointer StorageBuffer %blk_b
   %ptr_arr8 = OpTypePointer StorageBuffer %arr8
      %ptr_S = OpTypePointer StorageBuffer %S
     %in_var = OpVariable %ptr_blk_a StorageBuffer
    %out_var = OpVariable %ptr_blk_b StorageBuffer
       %main = OpFunction %void None %3
          %5 = OpLabel
         %pa = OpAccessChain %ptr_arr8 %in_var %int_0
          %a = OpLoad %arr8 %pa
         %a0 = OpCompositeExtract %float %a 0
         %a1 = OpCompositeExtract %float %a 1
         %a2 = OpCompositeExtract %float %a 2
         %a3 = OpCompositeExtract %float %a 3
         %a4 = OpCompositeExtract %float %a 4
         %a5 = OpCompositeExtract %float %a 5
         %a6 = OpCompositeExtract %float %a 6
         %a7 = OpCompositeExtract %float %a 7
          %v = OpCompositeConstruct %v2float %a0 %a1
         %c0 = OpCompositeConstruct %v2float %a3 %a4
         %c1 = OpCompositeConstruct %v2float %a5 %a6
          %m = OpCompositeConstruct %mat2 %c0 %c1
          %t = OpCompositeConstruct %arr2 %a7 %float_1_5
          %s = OpCompositeConstruct %S %v %a2 %m %t
         %ps = OpAccessChain %ptr_S %out_var %int_0
               OpStore %ps %s
               OpReturn
               OpFunctionEnd
