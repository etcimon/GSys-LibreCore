#version 450
// §12.3 texel-buffer — OpImageFetch on a textureBuffer (Dim=Buffer,
// UNIFORM_TEXEL_BUFFER kind 4).  Single linear texel index i -> texel i.
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) uniform textureBuffer tex;
layout(set = 0, binding = 1) buffer Out { vec4 o[]; } ob;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    ob.o[i] = texelFetch(tex, i);
}
