#version 450
// SPDX-License-Identifier: MIT
// T3: R8G8B8A8_UINT (device format 15) storage-image load + store.
// Lane i loads texel (i % 2, i / 2) of a 2x4 rgba8ui image, packs the
// four 8-bit integer channels into one SSBO word, and writes the texel
// back with each channel incremented (wraps in 8 bits on store), so both
// the decode arm and the 1-byte-per-channel store encode are observed.
layout(local_size_x = 8) in;
layout(rgba8ui, set = 0, binding = 1) uniform uimage2D img;
layout(set = 0, binding = 0) buffer Out { uint o[]; };
void main() {
    uint i = gl_LocalInvocationID.x;
    ivec2 p = ivec2(int(i % 2u), int(i / 2u));
    uvec4 v = imageLoad(img, p);
    o[i] = v.x | (v.y << 8) | (v.z << 16) | (v.w << 24);
    imageStore(img, p, v + uvec4(1u));
}
