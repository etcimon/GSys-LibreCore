#version 450
// §12.3 C/5b — OpImageFetch on a combined sampler2D (int coords,
// explicit Lod).  Reads a 4x4 RGBA8 texture at lane-varying texels.
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) uniform sampler2D tex;
layout(set = 0, binding = 1) buffer Out { vec4 o[]; } ob;

void main() {
    int i = int(gl_GlobalInvocationID.x);
    ob.o[i] = texelFetch(tex, ivec2(i & 3, (i >> 2) & 3), 0);
}
