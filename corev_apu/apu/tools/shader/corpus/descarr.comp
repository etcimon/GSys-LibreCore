#version 460
layout(local_size_x = 8) in;
// §12.3 F5: runtime descriptor-array index — ins[i/8] diverges across
// the 8-lane wave (two invocations per element for 32 gid).
layout(set = 0, binding = 0) buffer In { float v[]; } ins[4];
layout(set = 0, binding = 1) buffer Out { float o[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    o[i] = ins[i / 8].v[i];
}
