#version 450
// SPDX-License-Identifier: MIT
// StorageImageExtendedFormats: R32G32_SFLOAT (device format 8) storage
// image — the first extended-format storage session.  Lane i loads
// texel (i % 2, i / 2) of a 2x4 rg32f image; imageLoad returns the two
// fp32 channels in .x/.y (zw read as 0), both widened bit patterns are
// observed in the SSBO (2 words/lane), then imageStore writes .x+1.0 /
// .y+2.0 back so the two-channel store encode is checked on the out=1
// image readback.  rg32f is the only GLSL storage qualifier that maps to
// a device-table format outside the core set — it is what makes glslang
// emit OpCapability StorageImageExtendedFormats (49).
layout(local_size_x = 8) in;
layout(rg32f, set = 0, binding = 1) uniform image2D img;
layout(set = 0, binding = 0) buffer Out { uint o[]; };
void main() {
    uint i = gl_LocalInvocationID.x;
    ivec2 p = ivec2(int(i % 2u), int(i / 2u));
    vec4 v = imageLoad(img, p);
    o[i * 2] = floatBitsToUint(v.x);
    o[i * 2 + 1] = floatBitsToUint(v.y);
    imageStore(img, p, vec4(v.x + 1.0, v.y + 2.0, 0.0, 0.0));
}
