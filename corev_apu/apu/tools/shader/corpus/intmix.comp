#version 460
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) buffer Src { uint src[]; };
layout(set = 0, binding = 1) buffer Dst { uint dst[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    uint a = src[i];
    uint b = src[i + 32u];
    uint c = (a & b) | (a ^ 0x55AA55AAu);
    c = (c << 3) + (b >> 2);
    c = c + (a % 7u) + (b / 3u);
    int s = int(a) - int(b);
    c = c + uint(s * -3);
    c = c + uint(abs(s) + sign(s) * min(abs(s), 17));
    c = c + uint(max(int(a % 5), -s) + (int(a) % 6));
    c = c + uint((s % -7) + (s / -4));
    c = c + ((a > b) ? 1u : 0u) + ((a != b) ? 2u : 0u);
    c = ~c + (s <= int(b) ? 4u : 0u) + (int(a) >= -3 ? 8u : 0u);
    dst[i] = c;
}
