#version 460
// G3a-i: non-inlined SPIR-V function coverage — a value-param helper,
// an inout pointer-param helper, a depth-3 call chain, and a helper
// with an early return (two ReturnValue sites).
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) buffer Src { uint src[]; };
layout(set = 0, binding = 1) buffer Dst { uint dst[]; };

uint dbl(uint x) { return x * 2u + 1u; }

void accum(inout uint acc, uint v) { acc += v; }

uint l3(uint x) { return dbl(x) + 3u; }
uint l2(uint x) { return l3(x) + 7u; }

uint early(uint x) {
    if (x > 100u) return x - 50u;
    return x + 5u;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint a = src[i];
    uint b = src[i + 32u];
    uint acc = dbl(a);
    accum(acc, b);
    dst[i] = acc + l2(b) + early(a);
}
