#version 460
// §7d SFU smoke — pow(x,y) special cases: x<0 -> NaN (GLSL pow is
// undefined there — the sequence must produce NaN, not garbage),
// x==0 rules (y>0 -> 0, y==0 -> 1, y<0 -> +inf), x==1 -> 1, plus
// ordinary positive-base sweeps incl. huge/tiny exponents.
// a = src[i] (x in .xz), b = src[i+32] (y in .xz).
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) buffer Src { vec4 src[]; };
layout(set = 0, binding = 1) buffer Dst { vec4 dst[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 a = src[i];
    vec4 b = src[i + 32u];
    uint o = i * 2u;
    dst[o + 0u] = vec4(pow(a.x, b.x), pow(a.y, b.y),
                       pow(a.z, b.z), pow(a.w, b.w));
    dst[o + 1u] = vec4(pow(b.x, a.x), pow(b.y, a.y),
                       pow(b.z, a.z), pow(b.w, a.w));
}
