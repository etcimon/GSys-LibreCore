#version 460
layout(local_size_x = 32) in;
layout(set = 0, binding = 0) readonly buffer In { uint src[]; };
layout(set = 0, binding = 1) writeonly buffer Out { uint dst[]; };
void main() {
  uint i = gl_LocalInvocationIndex;
  uint n = src[i] & 15u;
  uint acc = 0u;
  for (uint k = 0u; k < n; k++) {
    if ((k & 3u) == 2u) continue;
    acc += k * src[i];
    if (acc > 500u) break;
  }
  dst[i] = acc;
}
