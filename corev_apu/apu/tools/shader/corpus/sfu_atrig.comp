#version 460
// §7d SFU smoke — asin/acos/atan/atan2: domains [-1,1] incl. the
// +-1 poles, out-of-domain -> NaN, atan2 all four quadrants and the
// signed-zero rules (atan2(+-0, -1) = +-pi, atan2(+-0, +1) = +-0).
// a = src[i], b = src[i+32].
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) buffer Src { vec4 src[]; };
layout(set = 0, binding = 1) buffer Dst { vec4 dst[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 a = src[i];
    vec4 b = src[i + 32u];
    uint o = i * 2u;
    dst[o + 0u] = vec4(asin(a.x), acos(a.y), atan(a.z),
                       atan(a.w, b.x));
    dst[o + 1u] = vec4(asin(b.y), acos(b.z), atan(b.w),
                       atan(a.x, a.y));
}
