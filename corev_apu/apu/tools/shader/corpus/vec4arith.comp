#version 460
layout(local_size_x = 8) in;
layout(set = 0, binding = 0) buffer Src { vec4 src[]; };
layout(set = 0, binding = 1) buffer Dst { vec4 dst[]; };
void main() {
    uint i = gl_GlobalInvocationID.x;
    vec4 a = src[i];
    vec4 b = src[i + 32u];
    vec4 c = a * b + vec4(1.0, -2.0, 0.5, 3.0);
    vec4 d = (c - a) / (b + vec4(2.0));
    dst[i] = -d + a * 0.25;
}
