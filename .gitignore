# Local toolchain installs (spike, verilator, …) — keep out of git
/tools/**
# Tracked monorepo maintenance scripts that live under tools/
!/tools/g6lc_submodule_forks.py
/util/toolchain-builder/src/
/util/toolchain-builder/build/
# Both following lines are needed to list contents of ISA manual build dir.
!/vendor/riscv/riscv-isa-manual/build/
!/vendor/riscv/riscv-isa-manual/build/*
/config/gen_from_riscv_config/hwconfig/linker/link.ld
/config/gen_from_riscv_config/hwconfig/spike/spike.yaml
/verif/sim/encaps.traces
/verif/sim/iti.traces
/verif/sim/verilator.fst.hier

# Local soak / sim noise (not part of GSys LibreCore product tree)
monorepo-soak/*.log
monorepo-soak/*.elf
monorepo-soak/*-trace.txt
monorepo-soak/logs/
encaps.traces
iti.traces

# Soft-ladder OpenSBI oracle ELF build products
software/smt2-linux/soft-ladder/build/


# Local fork work clones
.g6lc-forks/
.g6lc-forks-win/

# riscv-dev: ignore first-level dirs except scaffold agents/ + architecture/
# (generic: any nested checkout or toolchain extract; see riscv-dev/AGENTS-selectivity.md)
/riscv-dev/*/
!/riscv-dev/agents/
!/riscv-dev/architecture/
# Mode C shadows stay untracked; only the directory READMEs are scaffold
/riscv-dev/agents/*
!/riscv-dev/agents/README.md
/riscv-dev/architecture/*/
# Generic local process files (not package names)
/riscv-dev/TODO-scratch.md
/riscv-dev/TODO-scratch.*.md
/riscv-dev/setenv.ps1
/riscv-dev/setenv.sh
/riscv-dev/modules.json
/riscv-dev/local-semver.json
/riscv-dev/.gitignore

# riscv-compilers: ignore first-level dirs except scaffold agents/ + architecture/
# (generic: any nested checkout or toolchain extract; see riscv-compilers/AGENTS-selectivity.md)
/riscv-compilers/*/
!/riscv-compilers/agents/
!/riscv-compilers/architecture/
# Mode C shadows stay untracked; only the directory READMEs are scaffold
/riscv-compilers/agents/*
!/riscv-compilers/agents/README.md
/riscv-compilers/architecture/*/
# Generic local process files (not compiler names)
/riscv-compilers/TODO-scratch.md
/riscv-compilers/TODO-scratch.*.md
/riscv-compilers/setenv.ps1
/riscv-compilers/setenv.sh
/riscv-compilers/modules.json
/riscv-compilers/local-semver.json
/riscv-compilers/.gitignore

# Remote testharness credentials and outputs - never commit (AGENTS-build.md)
*.pass
th-remote.pass
/remote-runs/

# Ad-hoc probe scripts + their pulled outputs (the p<N>_ ladder). Every finding
# these produced is recorded in architecture/multi-threading/soft-ladder/ITERATION.md;
# the scripts themselves are single-use scaffolding, not product. Promote a probe
# by moving it under verif/regress/ with a real name instead of tracking it here.
/p[0-9]*_*.py
/p[0-9]*_*.sh
/p[0-9]*-output/
/*.zip
/.aside-untracked-*/

# g6lc_qemu: contained toolchain + Cargo output. `out/` holds emitted artifacts
# (DTBs, argv, firmware, generated QEMU C) and `qemu/` is the QEMU checkout that
# emission targets — both are SEPARATE GPL WORKS and are never tracked here
# (g6lc_qemu/AGENTS-licensing.md §2).
/g6lc_qemu/.tools/
/g6lc_qemu/target/
/g6lc_qemu/out/
/g6lc_qemu/qemu/

# Scratch RTL copies and editor backups (never a build input)
*.sv.bak
/core/fetch/

# Per-target config packages emitted by the build (target name is local)
/core/include/cva6_config_pkg.sv
/core/include/work-ver-*_config_pkg.sv

# Soft-ladder directed-mini / TRACE scratch output dirs
software/smt2-linux/soft-ladder/_mini_out/
software/smt2-linux/soft-ladder/_trace_fdt2/

# Remote-proxy one-shot probe scripts (the proxy itself is tracked)
/verif/regress/remote/analyze_*.py
/verif/regress/remote/check_proc.py
/verif/regress/remote/create_trace_*.py
/verif/regress/remote/run_fetch_snap_*.py
/verif/regress/remote/start_fetch_snap*.py

# SymbiYosys task working directories (dir name = <sby basename>[_<task>]).
# The .sby and *_props.sv inputs stay tracked; only the generated dirs are ignored.
core/**/formal/*/

# ai_island LiteX generation outputs and local trace artifacts.
corev_apu/ai_island/generated/
trace.spec

