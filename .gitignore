# Local toolchain installs (spike, verilator, …) — keep out of git
/tools/**
# Tracked monorepo maintenance scripts that live under tools/
!/tools/g6lc_submodule_forks.py
/util/toolchain-builder/src/
/util/toolchain-builder/build/
# Both following lines are needed to list contents of ISA manual build dir.
!/vendor/riscv/riscv-isa-manual/build/
!/vendor/riscv/riscv-isa-manual/build/*
/config/gen_from_riscv_config/hwconfig/linker/link.ld
/config/gen_from_riscv_config/hwconfig/spike/spike.yaml
/verif/sim/encaps.traces
/verif/sim/iti.traces
/verif/sim/verilator.fst.hier

# Local soak / sim noise (not part of GSys LibreCore product tree)
monorepo-soak/*.log
monorepo-soak/*.elf
monorepo-soak/*-trace.txt
monorepo-soak/logs/
encaps.traces
iti.traces

# Soft-ladder OpenSBI oracle ELF build products
software/smt2-linux/soft-ladder/build/


# Local fork work clones
.g6lc-forks/
.g6lc-forks-win/

# riscv-dev: ignore first-level dirs except scaffold agents/ + architecture/
# (generic: any nested checkout or toolchain extract; see riscv-dev/AGENTS-selectivity.md)
/riscv-dev/*/
!/riscv-dev/agents/
!/riscv-dev/architecture/
# Mode C shadows stay untracked; only the directory READMEs are scaffold
/riscv-dev/agents/*
!/riscv-dev/agents/README.md
/riscv-dev/architecture/*/
# Generic local process files (not package names)
/riscv-dev/TODO-scratch.md
/riscv-dev/TODO-scratch.*.md
/riscv-dev/setenv.ps1
/riscv-dev/setenv.sh
/riscv-dev/modules.json
/riscv-dev/local-semver.json
/riscv-dev/.gitignore

# riscv-compilers: ignore first-level dirs except scaffold agents/ + architecture/
# (generic: any nested checkout or toolchain extract; see riscv-compilers/AGENTS-selectivity.md)
/riscv-compilers/*/
!/riscv-compilers/agents/
!/riscv-compilers/architecture/
# Mode C shadows stay untracked; only the directory READMEs are scaffold
/riscv-compilers/agents/*
!/riscv-compilers/agents/README.md
/riscv-compilers/architecture/*/
# Generic local process files (not compiler names)
/riscv-compilers/TODO-scratch.md
/riscv-compilers/TODO-scratch.*.md
/riscv-compilers/setenv.ps1
/riscv-compilers/setenv.sh
/riscv-compilers/modules.json
/riscv-compilers/local-semver.json
/riscv-compilers/.gitignore
