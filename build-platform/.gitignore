# The workspace is fully managed by the build platform and never committed.
# It holds installed tools (workspace/tooling) and all build outputs
# (workspace/build), plus the generated Python environment.
# Exception: workspace/hyp is the timing-reworked RTL tree (out_rtl mirrors
# it) and is versioned; its remote-run artifacts and archives are not.
/workspace/*
!/workspace/hyp/
/workspace/hyp/*.zip
/workspace/hyp/**/remote-runs/
# sby/yosys formal run outputs and editor leftovers inside the hyp tree
/workspace/hyp/**/analysis/formal/*/model/
/workspace/hyp/**/analysis/formal/*/PASS
/workspace/hyp/**/analysis/formal/*/FAIL
/workspace/hyp/**/analysis/formal/*/status
/workspace/hyp/**/*.aig
/workspace/hyp/**/*.aim
/workspace/hyp/**/*.ywa
/workspace/hyp/**/*.sqlite
/workspace/hyp/**/*.bak
/workspace/hyp/**/nul

# Bun / Node local state
/node_modules/
bun.lock
bun.lockb

# Local, uncommitted config overlays (see src/config/load.ts).
/.config.local.ts
*.local.json

# Platform run logs and caches
/.cache/
*.log

# Remote testharness credentials (never commit)
.remote-ssh-creds
