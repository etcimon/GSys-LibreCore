# Keep managed tools, build outputs and Python environments local.
# Track timing-reworked RTL and analysis under workspace/hyp; out_rtl mirrors it.
/workspace/*
!/workspace/hyp/
# Keep top-level snapshot archives and remote-run outputs local.
/workspace/hyp/*.zip
/workspace/hyp/**/remote-runs/
# sby/yosys formal run outputs and editor leftovers inside the hyp tree
/workspace/hyp/**/analysis/formal/*/model/
/workspace/hyp/**/analysis/formal/*/PASS
/workspace/hyp/**/analysis/formal/*/FAIL
/workspace/hyp/**/analysis/formal/*/status
/workspace/hyp/**/*.aig
/workspace/hyp/**/*.aim
/workspace/hyp/**/*.ywa
/workspace/hyp/**/*.sqlite
/workspace/hyp/**/*.bak
/workspace/hyp/**/nul

# Bun / Node local state
/node_modules/
bun.lock
bun.lockb

# Local, uncommitted config overlays (see src/config/load.ts).
/.config.local.ts
*.local.json

# Platform run logs and caches
/.cache/
*.log

# Remote testharness credentials (never commit)
.remote-ssh-creds
