--- a/riscv/Proc.cc
+++ b/riscv/Proc.cc
@@ -227,7 +227,7 @@ Processor::Processor(
   string priv_str = this->params[base + "priv"].a_string;
   this->isa =
       (const isa_parser_t *)new isa_parser_t(isa_str.c_str(), priv_str.c_str());
-  std::cout << "[SPIKE] Proc 0 | ISA: " << isa_str << " PRIV: " << priv_str << std::endl;
