+def _popen_shell(cmd, **kwargs):
+    """Spawn a shell command portably.
+
+    Upstream used ``exec <cmd>`` with ``executable=/bin/bash``, which breaks on
+    native Windows Python (``shell=True`` + non-cmd shell becomes ``bash /c``).
+    On Windows, invoke bash as ``bash -c <cmd>`` without ``shell=True``.
+    """
+    is_win = platform.system() == "Windows"
+    bash = shutil.which("bash")
+    if bash and not is_win:
+        return subprocess.Popen(
+            "exec " + cmd,
+            shell=True,
+            executable=bash if os.path.isfile(bash) else "/bin/bash",
+            **kwargs,
+        )
+    if bash and is_win:
+        # Avoid shell=True: Python would pass /c (cmd.exe style) to bash.
+        return subprocess.Popen(
+            [bash, "-lc", cmd],
+            shell=False,
+            **kwargs,
+        )
+    return subprocess.Popen(cmd, shell=True, **kwargs)
+
 RET_SUCCESS = 0
