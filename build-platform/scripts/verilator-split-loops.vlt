split_var -module "cva6_hpdcache_wrapper" -var "dcache_req_tag"  // width 44, loops 10, fanout 50
split_var -module "cva6_hpdcache_wrapper" -var "dcache_req_pma"  // width 5, loops 10, fanout 50
split_var -module "hpdcache_core_arbiter" -var "core_req"  // width 755, loops 10, fanout 10
split_var -module "hpdcache_core_arbiter" -var "core_req_tag"  // width 220, loops 10, fanout 10
split_var -module "g6lc_smt_csr_bank" -var "commit_ack_g"  // width 4, loops 8, fanout 16
split_var -module "g6lc_smt_csr_bank" -var "csr_ex_b"  // width 203, loops 8, fanout 8
