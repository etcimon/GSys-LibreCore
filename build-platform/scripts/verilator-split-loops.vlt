split_var -module "g6lc_bp_tage" -var "t_tag"  // width 96, loops 7, fanout 7
split_var -module "load_store_unit" -var "lsu_req_i"  // width 386, loops 4, fanout 4
split_var -module "alu" -var "operand_a_bitmanip"  // width 64, loops 2, fanout 102
split_var -module "alu_wrapper" -var "fu_data_bypass"  // width 403, loops 2, fanout 42
