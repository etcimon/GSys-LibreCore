#
# Platform FO4 probe: the delay of one minimum inverter driving four copies
# of itself, measured on the liberty the mapped netlists were timed with.
# This is the unit that turns a mapped path delay into an "adjusted FO4" —
# the reading `sv-timing adjusted` compares against the structural budget,
# and the one that makes a GHz claim portable across processes
# (f = 1e6 * (1 - margin) / (adjusted_fo4 * fo4_ps)).
#
# The probe netlist (generated by the host from the liberty's own inverter
# cell and pin names, see build-platform/src/tooling/fo4Probe.ts) holds two
# independent chains of that inverter, 8 and 4 stages long, every stage
# loaded by four copies (the next stage plus three dummies). The FO4 is the
# arrival difference between the two chain outputs over the four extra
# stages: the input slew, the first stage and the output stage cancel, so
# the number is the steady-state stage delay, not a boundary artefact.
#
#   OR_LIBERTY=lib OR_VERILOG=fo4-probe.v OR_CELL=INV_X1 sta -exit openroad-fo4-probe.tcl
#
# One line on stdout: FO4_PROBE ps=<stage> cell=<cell> chain8_ns=<a> chain4_ns=<b>
# Any failure prints FO4_PROBE fail <reason>.

foreach {name} {OR_LIBERTY OR_VERILOG} {
  if {![info exists ::env($name)] || $::env($name) eq ""} {
    puts "FO4_PROBE fail $name is required"
    exit
  }
}
set cell [expr {[info exists ::env(OR_CELL)] ? $::env(OR_CELL) : "?"}]
foreach lib $::env(OR_LIBERTY) {
  read_liberty $lib
}
read_verilog $::env(OR_VERILOG)
if {[catch {set ok [link_design fo4_probe]} err] || !$ok} {
  puts "FO4_PROBE fail link: $err"
  exit
}
# A slew representative of a gate output; both chains see the same one.
set_input_transition 0.02 [all_inputs]
set_load 0 [all_outputs]

proc chain_arrival {from to} {
  set paths [find_timing_paths -unconstrained -from [get_ports $from] -to [get_ports $to] -group_path_count 1]
  if {[llength $paths] == 0} { return "" }
  return [[lindex $paths 0] data_arrival_time]
}
set a8 [chain_arrival a8 y8]
set a4 [chain_arrival a4 y4]
if {$a8 eq "" || $a4 eq ""} {
  puts "FO4_PROBE fail no unconstrained path through the chains"
  exit
}
# data_arrival_time is in seconds (as the module board reads it).
set a8_ns [expr {$a8 * 1e9}]
set a4_ns [expr {$a4 * 1e9}]
if {$a8_ns <= $a4_ns} {
  puts "FO4_PROBE fail chain8 ($a8_ns) not slower than chain4 ($a4_ns)"
  exit
}
set fo4_ps [expr {($a8_ns - $a4_ns) / 4.0 * 1000.0}]
puts [format "FO4_PROBE ps=%.3f cell=%s chain8_ns=%.4f chain4_ns=%.4f" $fo4_ps $cell $a8_ns $a4_ns]
