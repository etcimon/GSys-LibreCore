# Linux 6.6 kconfig overlay for g6lc64_smt2 RTL.
# Applied on top of OpenWrt sifiveu config-6.6 (and reusable by Ubuntu).
# Unknown symbols are closed by olddefconfig (see apply-virt-overlay.sh).
CONFIG_ARCH_RV64I=y
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_FPU=y
CONFIG_RISCV_ISA_C=y
# CONFIG_RISCV_ISA_V is not set
CONFIG_RISCV_ISA_ZBA=y
CONFIG_RISCV_ISA_ZBB=y
CONFIG_RISCV_ISA_ZBS=y
CONFIG_RISCV_ISA_ZICBOM=y
CONFIG_RISCV_ISA_ZICBOZ=y
CONFIG_RISCV_ISA_SVNAPOT=y
CONFIG_RISCV_ISA_SVPBMT=y
CONFIG_RISCV_ISA_SSTC=y
CONFIG_RISCV_ISA_ZIHINTPAUSE=y
CONFIG_RISCV_ISA_ZAWRS=y
# Zacas: present in later 6.x; 6.6 olddefconfig drops it if absent.
CONFIG_RISCV_ISA_ZACAS=y
CONFIG_RISCV_ALTERNATIVE=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_SBI_V01=y
CONFIG_RISCV_PMU_SBI=y
CONFIG_MMU=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFI_GENERIC_STUB=y
