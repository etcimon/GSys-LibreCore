{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gsys.dev/g6lc_qemu/schemas/target-model.schema.json",
  "title": "g6lc_qemu TargetModel",
  "description": "The single interface between ingest and every backend. No emitter, virtual machine or diagnosis model reads a design file directly; they all read this. Consumers MUST read schema_version before the payload. Addresses and sizes are strings because a JSON number cannot carry a 64-bit address without loss.",
  "type": "object",
  "required": ["schema_version", "generated_by", "target", "isa", "soc", "conformance"],
  "additionalProperties": false,
  "properties": {
    "_comment": {
      "description": "Ignored by consumers; permitted so fixtures can explain themselves.",
      "type": ["string", "array"]
    },
    "schema_version": {
      "description": "Bumped on any field rename or semantic change. Never reinterpret silently.",
      "const": "2"
    },
    "generated_by": {
      "type": "object",
      "required": ["tool", "version"],
      "additionalProperties": false,
      "properties": {
        "tool": { "const": "g6lc-qemu" },
        "version": { "type": "string" },
        "rev": { "type": ["string", "null"] }
      }
    },
    "provenance": {
      "description": "Where the facts came from, so a model attached to a bug report is self-describing and a stale one is detectable.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design_root": { "type": ["string", "null"] },
        "design_rev": { "type": ["string", "null"] },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path", "sha256"],
            "additionalProperties": false,
            "properties": {
              "path": { "type": "string" },
              "sha256": { "type": "string" }
            }
          }
        },
        "defines": { "type": "array", "items": { "type": "string" } },
        "overrides": {
          "description": "Command-line forcings. Their presence makes downstream artifacts synthetic.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "value", "origin"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "value": { "type": "string" },
              "origin": { "type": "string" }
            }
          }
        },
        "derivations": {
          "description": "Fields the design's own build step derives from the written package (masked dependencies, implied extensions, inferred widths, raised floors). NOT overrides: these are what the design elaborates, so they do not taint the model.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "change", "reason"],
            "additionalProperties": false,
            "properties": {
              "field": { "type": "string" },
              "change": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": ["id", "plane", "profile", "faithful"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "plane": { "enum": ["core", "apu", "soc"] },
        "profile": {
          "description": "g6lc-soc is byte-faithful to the design and is the only profile a diagnosis may cite. g6lc-virt adds virtio so an operating system can boot and is software-valid, hardware-invalid.",
          "enum": ["g6lc-soc", "g6lc-virt"]
        },
        "faithful": {
          "description": "False as soon as any override deviates from the design's own description. Travels with every artifact.",
          "type": "boolean"
        }
      }
    },
    "isa": {
      "type": "object",
      "required": ["xlen", "base", "extensions"],
      "additionalProperties": false,
      "properties": {
        "xlen": { "type": "integer", "enum": [32, 64] },
        "base": { "type": "string" },
        "isa_string": { "type": "string" },
        "mmu_mode": { "type": ["string", "null"] },
        "timebase_hz": { "type": "integer", "minimum": 1 },
        "paddr_bits": { "type": "integer", "minimum": 0 },
        "vaddr_bits": { "type": "integer", "minimum": 0 },
        "page_table_levels": { "type": "integer", "minimum": 0 },
        "vpn_bits": { "type": "integer", "minimum": 0 },
        "satp_mode": { "type": "integer", "minimum": 0 },
        "extensions": {
          "description": "Token to verdict. A verdict, never a bare boolean: `true` cannot express 'enabled but the unit is a stub'.",
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/verdict" }
        },
        "vendor_ids": {
          "description": "Read from the same place the design reads them. Never fabricated.",
          "type": "object",
          "additionalProperties": { "type": ["string", "null"] }
        }
      }
    },
    "csr": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "implemented": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["addr", "name"],
            "additionalProperties": false,
            "properties": {
              "addr": { "$ref": "#/$defs/hex" },
              "name": { "type": "string" },
              "gate": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "uarch": {
      "description": "Structure sizes. Carried in full: fields the readers do not semantically understand still land in `raw`, so a later backend can use them without a re-ingest.",
      "type": "object"
    },
    "soc": {
      "type": "object",
      "required": ["peripherals", "intc", "harts_total"],
      "additionalProperties": false,
      "properties": {
        "peripherals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "base", "len"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "base": { "$ref": "#/$defs/hex" },
              "len": { "$ref": "#/$defs/hex" },
              "model": { "type": ["string", "null"] },
              "irq": { "type": ["integer", "null"] },
              "reg_shift": { "type": ["integer", "null"] },
              "reg_io_width": { "type": ["integer", "null"] },
              "clock_frequency": { "type": ["integer", "null"] },
              "current_speed": { "type": ["integer", "null"] }
            }
          }
        },
        "dram": {
          "type": ["object", "null"],
          "required": ["base", "len"],
          "additionalProperties": false,
          "properties": {
            "base": { "$ref": "#/$defs/hex" },
            "len": { "$ref": "#/$defs/hex" }
          }
        },
        "intc": {
          "type": "object",
          "required": ["sources", "targets", "contexts_per_hart"],
          "additionalProperties": false,
          "properties": {
            "sources": { "type": "integer", "minimum": 0 },
            "targets": { "type": "integer", "minimum": 0 },
            "contexts_per_hart": { "type": "integer", "minimum": 0 },
            "max_harts": {
              "description": "targets / contexts_per_hart. The constraint that silently caps how many CPUs a guest can be given, so it is computed rather than assumed.",
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "harts_total": {
          "description": "Logical harts: cores multiplied by threads per core. Issue width is not a hart.",
          "type": "integer",
          "minimum": 0
        },
        "virtio_mmio": {
          "description": "Number of virtio-mmio transports the virt profile adds to the SoC memory map.",
          "type": ["integer", "null"],
          "minimum": 0
        },
        "bootrom": {
          "description": "Memory-mapped boot ROM used by the generated QEMU machine. Null means no MROM (direct kernel reset).",
          "type": ["object", "null"],
          "required": ["base", "len"],
          "additionalProperties": false,
          "properties": {
            "base": { "$ref": "#/$defs/hex" },
            "len": { "$ref": "#/$defs/hex" }
          }
        },
        "bootargs": {
          "description": "Kernel boot arguments advertised in the device tree chosen node.",
          "type": ["string", "null"]
        },
        "stdout_path": {
          "description": "Console path advertised in the device tree chosen node.",
          "type": ["string", "null"]
        },
        "cores": {
          "description": "Number of physical cores, when known from the design.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "threads_per_core": {
          "description": "Number of hardware threads per core, when known from the design.",
          "type": ["integer", "null"],
          "minimum": 1
        },
        "ai_island": {
          "description": "SI-island model, when the design exposes one.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "config": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cap_version": { "type": "integer", "minimum": 0 },
                "clusters": { "type": "integer", "minimum": 1 },
                "macs_per_cycle": { "type": "integer", "minimum": 1 },
                "clock_khz": { "type": "integer", "minimum": 1 },
                "sram_bytes": { "type": "integer", "minimum": 0 },
                "acc_tile_m": { "type": "integer", "minimum": 1 },
                "acc_tile_n": { "type": "integer", "minimum": 1 },
                "acc_tile_k": { "type": "integer", "minimum": 1 },
                "noc_width": { "type": "integer", "minimum": 1 },
                "dram_channels": { "type": "integer", "minimum": 0 },
                "dram_gbps": { "type": "integer", "minimum": 0 },
                "measured_dram_gbps_x1000": {
                  "description": "Measured sustained DRAM bandwidth in milli-GB/s, from the cap window. Null means no measurement.",
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "queues": { "type": "integer", "minimum": 0 },
                "queue_depth": { "type": "integer", "minimum": 0 },
                "qos_classes": { "type": "integer", "minimum": 0 },
                "work_quantum_k": { "type": "integer", "minimum": 0 },
                "dtype_mask": {
                  "description": "Data-type grant bits the cap window reports. Null means the design does not publish the value.",
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "block_mnk": {
                  "description": "Packed block_mnk capability word layout. Null means the design does not publish the bit layout.",
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "properties": {
                    "m_low": { "type": "integer", "minimum": 0 },
                    "m_width": { "type": "integer", "minimum": 1 },
                    "n_low": { "type": "integer", "minimum": 0 },
                    "n_width": { "type": "integer", "minimum": 1 },
                    "k_low": { "type": "integer", "minimum": 0 },
                    "k_width": { "type": "integer", "minimum": 1 }
                  },
                  "required": ["m_low", "m_width", "n_low", "n_width", "k_low", "k_width"]
                },
                "cap_packed": {
                  "description": "Packed capability words whose bit layout is not a single flat value. Object keys are capability names; each value is a list of fields from LSB to MSB.",
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "name": { "type": "string" },
                        "low": { "type": "integer", "minimum": 0 },
                        "width": { "type": "integer", "minimum": 1 }
                      },
                      "required": ["name", "low", "width"]
                    }
                  }
                },
                "cap_offsets": {
                  "type": "object",
                  "additionalProperties": { "type": "integer", "minimum": 0 }
                },
                "cap_base": {
                  "description": "Base of the capability window inside the island MMIO region. Null means the design does not publish the placement; it does not mean zero.",
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "desc_base": {
                  "description": "Base of the descriptor latch window inside the island MMIO region. Descriptor field offsets are relative to this. Null means unresolved.",
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "queue_cluster_map": {
                  "description": "Queue-to-cluster map when the design publishes it. The i-th queue dispatches to cluster map[i mod map.len()]. Null means unresolved.",
                  "type": ["array", "null"],
                  "items": { "type": "integer", "minimum": 0 }
                },
                "pmu_offsets": {
                  "description": "Island PMU register offsets by name, from PMU_OFF_* localparams. These are the design's own measured counters, the only quantities that can contradict the modelled roofline bound. Empty when the design publishes the register map only as comments.",
                  "type": "object",
                  "additionalProperties": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "desc_layout": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "desc_bytes": { "type": "integer", "minimum": 0 },
                "operand_b_k_major": { "type": ["boolean", "null"] },
                "version": {
                  "description": "Descriptor version the island implements. Null means the package does not publish it, so a bring-up fallback is in use.",
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "fields": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "offset": { "type": "integer", "minimum": 0 },
                      "size": { "type": "integer", "minimum": 0 },
                      "bit_low": { "type": "integer", "minimum": 0 },
                      "bit_high": { "type": "integer", "minimum": 0 }
                    }
                  }
                },
                "ops": {
                  "type": "object",
                  "additionalProperties": { "type": "integer", "minimum": 0 }
                },
                "statuses": {
                  "type": "object",
                  "additionalProperties": { "type": "integer", "minimum": 0 }
                },
                "flags_layout": {
                  "description": "Packed flags word layout derived from desc_prio/desc_irq, the per-field arithmetic-type accessors, and comments. Null means the design does not publish the layout.",
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "properties": {
                    "dtype_shift": { "type": "integer", "minimum": 0 },
                    "dtype_mask": { "type": "integer", "minimum": 0 },
                    "priority_shift": { "type": "integer", "minimum": 0 },
                    "priority_mask": { "type": "integer", "minimum": 0 },
                    "irq_bit": { "type": "integer", "minimum": 0 },
                    "dtype_combined": {
                      "description": "True when dtype_shift/dtype_mask came from a combined 'type fields' comment rather than a per-field accessor, so the extracted value mixes several ABI subfields and must not be reported as a data type.",
                      "type": "boolean"
                    },
                    "accmode": {
                      "description": "Accumulate-mode selector, when the design publishes a desc_accmode accessor. Null means unresolved.",
                      "type": ["object", "null"],
                      "additionalProperties": false,
                      "properties": {
                        "shift": { "type": "integer", "minimum": 0 },
                        "mask": { "type": "integer", "minimum": 0 }
                      }
                    },
                    "ew": {
                      "description": "Element-width (sub-byte) selector, when the design publishes a desc_ew accessor. While null, no backend may claim a sub-byte effective-throughput multiplier.",
                      "type": ["object", "null"],
                      "additionalProperties": false,
                      "properties": {
                        "shift": { "type": "integer", "minimum": 0 },
                        "mask": { "type": "integer", "minimum": 0 }
                      }
                    },
                    "numfmt": {
                      "type": ["object", "null"],
                      "additionalProperties": false,
                      "properties": {
                        "shift": { "type": "integer", "minimum": 0 },
                        "mask": { "type": "integer", "minimum": 0 }
                      }
                    },
                    "sp24_bit": {
                      "description": "Bit index of the structured 2:4 sparsity request, when the design publishes a desc_sp24 accessor. Null means unresolved.",
                      "type": ["integer", "null"],
                      "minimum": 0
                    }
                  }
                },
                "completion": {
                  "description": "Completion word bit layout derived from make_completion. Null means the design does not publish the layout and the ai.poll path cannot decode it.",
                  "type": ["object", "null"],
                  "additionalProperties": false,
                  "properties": {
                    "ticket_bit_low": { "type": "integer", "minimum": 0 },
                    "ticket_bit_high": { "type": "integer", "minimum": 0 },
                    "status_bit_low": { "type": "integer", "minimum": 0 },
                    "status_bit_high": { "type": "integer", "minimum": 0 }
                  }
                }
              }
            },
            "instr_set": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "opcode_custom2": { "type": "integer", "minimum": 0 },
                "mask_f7f3op": { "type": "integer", "minimum": 0 },
                "csr_aiqbase": { "type": "integer", "minimum": 0 },
                "csr_aiqctl": { "type": "integer", "minimum": 0 },
                "csr_aiqhead": { "type": "integer", "minimum": 0 },
                "match_enq": { "type": "integer", "minimum": 0 },
                "match_poll": { "type": "integer", "minimum": 0 },
                "match_qfence": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "apu": {
          "description": "APU (Venus virtio-gpu backend) geometry from g6lc_apu_cfg_pkg.sv's ApuVenus literal and g6lc_apu_pkg.sv's APU_SHM_* constants. Null when the flist does not name the APU packages.",
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "mmio_base": { "$ref": "#/$defs/hex" },
            "mmio_len": { "$ref": "#/$defs/hex" },
            "control_base": { "$ref": "#/$defs/hex" },
            "control_len": { "$ref": "#/$defs/hex" },
            "irq_source": { "type": "integer", "minimum": 0 },
            "dma_window_base": { "$ref": "#/$defs/hex" },
            "dma_window_bytes": { "$ref": "#/$defs/hex" },
            "shm_base": { "$ref": "#/$defs/hex" },
            "shm_bytes": { "$ref": "#/$defs/hex" },
            "shm_id": { "type": "integer", "minimum": 0 },
            "num_capsets": { "type": "integer", "minimum": 0 },
            "num_scanouts": { "type": "integer", "minimum": 0 },
            "num_queues": { "type": "integer", "minimum": 0 },
            "queue_depth": { "type": "integer", "minimum": 0 }
          }
        },
        "apu_bridge": {
          "description": "Machine-profile choice (not an RTL constant): true means the generated machine instantiates the external-RTL apu_bridge socket device at the APU virtio-mmio window.",
          "type": ["boolean", "null"]
        }
      }
    },
    "accel": { "type": "object" },
    "pmu": {
      "description": "Group to index to symbolic event name, derived from the design's own counter module so an added event appears without an edit.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "counter_count": { "type": "integer", "minimum": 0 },
        "counter_mask": { "type": "integer", "minimum": 0 },
        "idx_width": { "type": "integer", "minimum": 0 },
        "grp_width": { "type": "integer", "minimum": 0 },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/pmu_event" }
        },
        "groups": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "unresolved": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "flist": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supply": { "type": ["string", "null"] },
        "files": { "type": "integer", "minimum": 0 },
        "defines": { "type": "array", "items": { "type": "string" } },
        "membership": { "type": "object" }
      }
    },
    "conformance": { "$ref": "conformance.schema.json" }
  },
  "$defs": {
    "hex": {
      "description": "A lowercase 0x-prefixed address or size.",
      "type": "string",
      "pattern": "^0x[0-9a-f]+$"
    },
    "verdict": {
      "enum": ["live", "stub", "absent", "undeclared", "overdeclared", "unresolved", "synthetic"]
    },
    "pmu_event": {
      "type": "object",
      "required": ["name", "group", "index", "mhpmevent"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string" },
        "group": { "type": "integer", "minimum": 0 },
        "index": { "type": "integer", "minimum": 0 },
        "mhpmevent": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
