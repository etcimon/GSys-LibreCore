# QEMU virt extras on top of OpenWrt sifiveu config-6.6.
# sifiveu already has CONFIG_EFI_STUB / GENERIC_STUB / PCI_HOST_GENERIC.
CONFIG_SOC_VIRT=y
# SOC_VIRT selects GOLDFISH + POWER_RESET_* and, if RTC_CLASS, RTC_DRV_GOLDFISH.
# Those selects expose tristate NEW symbols (GOLDFISH_TTY/PIPE) that make
# OpenWrt's `make syncconfig` fail non-interactively. Pin the policy here;
# apply-virt-overlay.sh also hooks olddefconfig into Kernel/Configure.
CONFIG_GOLDFISH=y
# CONFIG_GOLDFISH_TTY is not set
# CONFIG_GOLDFISH_PIPE is not set
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_ANCHOR=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_HVC_RISCV_SBI=y
CONFIG_HVC_DRIVER=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_EFI_STUB=y
CONFIG_EFI_GENERIC_STUB=y
# RISC-V 6.6: CMDLINE_EXTEND is a choice under CMDLINE_BOOL. Without
# CMDLINE_BOOL, `make syncconfig` prompts and fails non-interactively.
CONFIG_CMDLINE_BOOL=y
# `uio_pdrv_genirq.of_id` is the binding path for a kernel whose device tree does not
# carry the "generic-uio" fallback compatible. corev_apu/bootrom/ariane-ai.dts does
# carry it, so this is belt-and-braces: an out-of-date DTB still binds.
CONFIG_CMDLINE="console=ttyS0,115200n8 console=hvc0 earlycon=sbi maxcpus=2 uio_pdrv_genirq.of_id=g6lc,ai-matrix"
CONFIG_CMDLINE_EXTEND=y
# CONFIG_CMDLINE_FORCE is not set
# CONFIG_CMDLINE_FALLBACK is not set
# --- in-guest ai-tensor over UIO (architecture/ai-matrix/board-uio-eventfd.md) ---
# The generic UIO platform driver is what lets a userspace runtime mmap the
# g6lc,ai-matrix window and block on its PLIC line without an out-of-tree driver.
# The generic config-6.6 has `# CONFIG_UIO is not set`, so this must be explicit.
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y
# Operands live in the `no-map` reserved-memory carve-out, so userspace maps them
# through /dev/mem. STRICT_DEVMEM would refuse that for a range the kernel does not
# consider RAM it owns; the carve-out is exactly such a range.
CONFIG_DEVMEM=y
# CONFIG_STRICT_DEVMEM is not set
CONFIG_OF_RESERVED_MEM=y
CONFIG_DMA_CMA=y
