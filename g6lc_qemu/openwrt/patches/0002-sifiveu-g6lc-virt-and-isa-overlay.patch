From: Etienne Cimon <etcimon@globecsys.com>
Subject: [PATCH] sifiveu: G6LC virt + g6lc64_smt2 ISA overlay

Appended to official target/linux/sifiveu/config-6.6. Tokens match
corev_apu/bootrom/ariane-smt2.dts / g6lc64_smt2_config_pkg.
Refresh with extract-patches.sh after editing kernel-virt.config or
linux-dist/isa/kernel-6.6.config.

---
 target/linux/sifiveu/config-6.6 | 80 +++++++++++++++++++++++++++++++++++++++++
 1 file changed, 80 insertions(+)

diff --git a/target/linux/sifiveu/config-6.6 b/target/linux/sifiveu/config-6.6
--- a/target/linux/sifiveu/config-6.6
+++ b/target/linux/sifiveu/config-6.6
@@ -399,4 +399,63 @@ CONFIG_WATCHDOG_CORE=y
 CONFIG_XPS=y
 CONFIG_ZLIB_INFLATE=y
 CONFIG_ZONE_DMA32=y
+# BEGIN G6LC-VIRT-OVERLAY
+# QEMU virt extras on top of OpenWrt sifiveu config-6.6.
+CONFIG_SOC_VIRT=y
+CONFIG_GOLDFISH=y
+# CONFIG_GOLDFISH_TTY is not set
+# CONFIG_GOLDFISH_PIPE is not set
+CONFIG_POWER_RESET=y
+CONFIG_POWER_RESET_SYSCON=y
+CONFIG_POWER_RESET_SYSCON_POWEROFF=y
+CONFIG_VIRTIO=y
+CONFIG_VIRTIO_MENU=y
+CONFIG_VIRTIO_PCI=y
+CONFIG_VIRTIO_PCI_LEGACY=y
+CONFIG_VIRTIO_BLK=y
+CONFIG_VIRTIO_NET=y
+CONFIG_VIRTIO_MMIO=y
+CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
+CONFIG_VIRTIO_CONSOLE=y
+CONFIG_VIRTIO_ANCHOR=y
+CONFIG_SERIAL_8250=y
+CONFIG_SERIAL_8250_CONSOLE=y
+CONFIG_SERIAL_8250_NR_UARTS=4
+CONFIG_SERIAL_8250_RUNTIME_UARTS=4
+CONFIG_SERIAL_OF_PLATFORM=y
+CONFIG_HVC_RISCV_SBI=y
+CONFIG_HVC_DRIVER=y
+CONFIG_BLK_DEV_INITRD=y
+CONFIG_RD_GZIP=y
+CONFIG_DEVTMPFS=y
+CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_TMPFS=y
+CONFIG_EFI_STUB=y
+CONFIG_EFI_GENERIC_STUB=y
+CONFIG_CMDLINE_BOOL=y
+CONFIG_CMDLINE="console=ttyS0,115200n8 console=hvc0 earlycon=sbi maxcpus=2"
+CONFIG_CMDLINE_EXTEND=y
+# CONFIG_CMDLINE_FORCE is not set
+# CONFIG_CMDLINE_FALLBACK is not set
+# g6lc64_smt2 RTL ISA (see g6lc_qemu/linux-dist/isa/)
+CONFIG_SMP=y
+CONFIG_NR_CPUS=2
+CONFIG_FPU=y
+CONFIG_RISCV_ISA_C=y
+# CONFIG_RISCV_ISA_V is not set
+CONFIG_RISCV_ISA_ZBA=y
+CONFIG_RISCV_ISA_ZBB=y
+CONFIG_RISCV_ISA_ZBS=y
+CONFIG_RISCV_ISA_ZICBOM=y
+CONFIG_RISCV_ISA_ZICBOZ=y
+CONFIG_RISCV_ISA_SVNAPOT=y
+CONFIG_RISCV_ISA_SVPBMT=y
+CONFIG_RISCV_ISA_SSTC=y
+CONFIG_RISCV_ISA_ZIHINTPAUSE=y
+CONFIG_RISCV_ISA_ZAWRS=y
+CONFIG_RISCV_ISA_ZACAS=y
+CONFIG_RISCV_ALTERNATIVE=y
+CONFIG_RISCV_SBI=y
+CONFIG_RISCV_PMU_SBI=y
+# END G6LC-VIRT-OVERLAY

