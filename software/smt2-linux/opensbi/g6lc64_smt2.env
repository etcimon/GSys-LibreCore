# CVA6 SMT2 OpenSBI make fragment (source before make, or pass on CLI).
# SPDX-License-Identifier: MIT
# Copyright (c) 2026 Etienne Cimon
#
# Usage (from OpenSBI source tree):
#   make PLATFORM=generic $(cat path/to/g6lc64_smt2.env | xargs) ...
# Prefer the build-opensbi-smt2 scripts which set these safely.

# FDT platform — multi-hart from DTB (do not use single-hart legacy platforms)
PLATFORM=generic

# CVA6 / Ariane DRAM base (matches ariane_soc DRAMBase, DTS memory@80000000)
FW_TEXT_START=0x80000000

# Dynamic info + payload flavors are selected by the build script:
#   FW_PAYLOAD=y  FW_PAYLOAD_PATH=<elf or Image>
#   FW_FDT_PATH=<ariane-smt2.dtb>

# Optional: print OpenSBI banner on all harts (debug)
# FW_OPTIONS=0
