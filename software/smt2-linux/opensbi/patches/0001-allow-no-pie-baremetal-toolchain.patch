From: Etienne Cimon
Subject: [PATCH] Allow non-PIE link for bare-metal toolchains (Windows xPack)

riscv-none-elf-ld from xPack does not support -pie. CVA6 SMT2 sim/FPGA
loads OpenSBI at a fixed FW_TEXT_START, so a non-PIE image is acceptable.
Enable with: make OPENSBI_ALLOW_NO_PIE=y

diff --git a/Makefile b/Makefile
--- a/Makefile
+++ b/Makefile
@@ -180,8 +180,12 @@
 CC_SUPPORT_ZICSR_ZIFENCEI := $(shell $(CC) $(CLANG_TARGET) $(RELAX_FLAG) -nostdlib -march=rv$(OPENSBI_CC_XLEN)imafd_zicsr_zifencei -x c /dev/null -o /dev/null 2>&1 | grep "zicsr\|zifencei" > /dev/null && echo n || echo y)
 
 ifneq ($(OPENSBI_LD_PIE),y)
+ifeq ($(OPENSBI_ALLOW_NO_PIE),y)
+$(info *** OpenSBI: linker lacks -pie; building non-PIE (OPENSBI_ALLOW_NO_PIE=y) ***)
+else
 $(error Your linker does not support creating PIEs, opensbi requires this.)
 endif
+endif
 
 # Build Info:
 # OPENSBI_BUILD_TIME_STAMP -- the compilation time stamp
@@ -365,10 +369,14 @@
 CFLAGS		+=	-fno-stack-protector -fno-builtin
 CFLAGS		+=	-fno-delete-null-pointer-checks
 ifeq ($(OPENSBI_LD_PIE),y)
 CFLAGS		+=	-fPIE -pie
 endif
+ifneq ($(OPENSBI_LD_PIE),y)
+CFLAGS		+=	-fno-PIE
+endif
 ASFLAGS		+=	-g -Wall -nostdlib
 ifeq ($(OPENSBI_LD_PIE),y)
 ASFLAGS		+=	-fPIE
 endif
@@ -400,7 +408,9 @@
 ELFFLAGS	+=	$(USE_LD_FLAG)
 ELFFLAGS	+=	-Wl,--build-id=none -N -static-libgcc -lgcc
 ifeq ($(OPENSBI_LD_PIE),y)
 ELFFLAGS	+=	-Wl,--no-dynamic-linker -Wl,-pie
 endif
